<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:VarVault.App.Controls">

  <!-- Shared control themes for the reusable GUI components (SC-2 … SC-12). -->

  <!-- SC-2 · Card -->
  <ControlTheme x:Key="{x:Type c:Card}" TargetType="c:Card">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="14">
          <StackPanel Spacing="2">
            <TextBlock Text="{TemplateBinding Header}"
                       Foreground="{DynamicResource TextHiBrush}"
                       FontWeight="SemiBold" FontSize="14"
                       IsVisible="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-10 · Toast -->
  <ControlTheme x:Key="{x:Type c:Toast}" TargetType="c:Toast">
    <Setter Property="Template">
      <ControlTemplate>
        <Border IsVisible="{TemplateBinding IsOpen}"
                Background="{DynamicResource Bg3Brush}" BorderBrush="{DynamicResource BorderHiBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{TemplateBinding Message}" Foreground="{DynamicResource TextHiBrush}"
                       VerticalAlignment="Center" />
            <Button Name="PART_Undo" Content="Undo" IsVisible="{TemplateBinding HasUndo}"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentHiBrush}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-9 · ModalHost / dialog base -->
  <ControlTheme x:Key="{x:Type c:ModalHost}" TargetType="c:ModalHost">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Backdrop" Background="#99000000" IsVisible="{TemplateBinding IsOpen}">
          <Border Name="PART_Dialog" Focusable="True"
                  Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderHiBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}"
                  MinWidth="420" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12">
                <TextBlock Grid.Column="0" Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource TextHiBrush}" />
                <Button Grid.Column="1" Name="PART_Close" Content="✕" Background="Transparent" BorderThickness="0" />
              </Grid>
              <ContentControl DockPanel.Dock="Bottom" Content="{TemplateBinding Footer}" Margin="16,10"
                              HorizontalAlignment="Right" />
              <ContentPresenter Content="{TemplateBinding Content}" Margin="16,4,16,4" />
            </DockPanel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-8 · SearchableCombo -->
  <ControlTheme x:Key="{x:Type c:SearchableCombo}" TargetType="c:SearchableCombo">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Button Name="PART_Button" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{TemplateBinding SelectedName}" Foreground="{DynamicResource TextHiBrush}" />
              <TextBlock Text="▾" Opacity="0.6" />
            </StackPanel>
          </Button>
          <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsOpen}" PlacementTarget="{Binding #PART_Button}"
                 Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
            <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderHiBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="6" MinWidth="220">
              <StackPanel Spacing="6">
                <TextBox Name="PART_Search" Text="{Binding FilterText, RelativeSource={RelativeSource TemplatedParent}}"
                         Watermark="Search…" />
                <ListBox Name="PART_List" MaxHeight="260"
                         ItemsSource="{TemplateBinding FilteredOptions}"
                         SelectedIndex="{Binding HighlightedIndex, RelativeSource={RelativeSource TemplatedParent}}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="c:ComboOption">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding Count}" Opacity="0.6" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No matches" Opacity="0.6" HorizontalAlignment="Center"
                           IsVisible="{TemplateBinding IsEmpty}" />
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-7 · StatTile -->
  <ControlTheme x:Key="{x:Type c:StatTile}" TargetType="c:StatTile">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="6">
          <TextBlock Text="{TemplateBinding Value}" FontSize="24" FontWeight="SemiBold"
                     Foreground="{TemplateBinding ValueBrush}" />
          <TextBlock Text="{TemplateBinding Unit}" Foreground="{DynamicResource TextLoBrush}"
                     FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,3" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-7 · TempDot -->
  <ControlTheme x:Key="{x:Type c:TempDot}" TargetType="c:TempDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Dot" CornerRadius="4" Background="{DynamicResource ColdBrush}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^.hot /template/ Border#PART_Dot"><Setter Property="Background" Value="{DynamicResource HotBrush}" /></Style>
    <Style Selector="^.warm /template/ Border#PART_Dot"><Setter Property="Background" Value="{DynamicResource WarmBrush}" /></Style>
    <Style Selector="^.cold /template/ Border#PART_Dot"><Setter Property="Background" Value="{DynamicResource ColdBrush}" /></Style>
  </ControlTheme>

  <!-- SC-6 · MeterBar -->
  <ControlTheme x:Key="{x:Type c:MeterBar}" TargetType="c:MeterBar">
    <Setter Property="Height" Value="5" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Bg3Brush}" CornerRadius="3" ClipToBounds="True">
          <Grid Name="PART_Track" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-6 · StackedBar -->
  <ControlTheme x:Key="{x:Type c:StackedBar}" TargetType="c:StackedBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border CornerRadius="4" ClipToBounds="True">
          <Grid Name="PART_Track" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-5 · StatePill (ok/sub/miss) — colour + text label -->
  <ControlTheme x:Key="{x:Type c:StatePill}" TargetType="c:StatePill">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" CornerRadius="4" Padding="6,1" Background="{DynamicResource Bg3Brush}">
          <TextBlock Name="PART_Text" Text="{TemplateBinding Text}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.ok /template/ Border#PART_Bg"><Setter Property="Background" Value="{DynamicResource GoodBgBrush}" /></Style>
    <Style Selector="^.ok /template/ TextBlock#PART_Text"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}" /></Style>
    <Style Selector="^.sub /template/ Border#PART_Bg"><Setter Property="Background" Value="{DynamicResource WarnBgBrush}" /></Style>
    <Style Selector="^.sub /template/ TextBlock#PART_Text"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="^.miss /template/ Border#PART_Bg"><Setter Property="Background" Value="{DynamicResource CritBgBrush}" /></Style>
    <Style Selector="^.miss /template/ TextBlock#PART_Text"><Setter Property="Foreground" Value="{DynamicResource CritBrush}" /></Style>
  </ControlTheme>

  <!-- SC-5 · Chip (filter) -->
  <ControlTheme x:Key="{x:Type c:Chip}" TargetType="c:Chip">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" CornerRadius="100" Padding="10,3" BorderThickness="1"
                Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderBrush}">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{DynamicResource TextBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.active /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource AccentBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>
  </ControlTheme>

  <!-- SC-5 · Tag (default/good/warn/crit) -->
  <ControlTheme x:Key="{x:Type c:Tag}" TargetType="c:Tag">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" CornerRadius="6" Padding="8,2" BorderThickness="1"
                Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderBrush}">
          <ContentPresenter Name="PART_Content" Content="{TemplateBinding Content}" Foreground="{DynamicResource TextBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.good /template/ Border#PART_Bg"><Setter Property="Background" Value="{DynamicResource GoodBgBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="^.warn /template/ Border#PART_Bg"><Setter Property="Background" Value="{DynamicResource WarnBgBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="^.crit /template/ Border#PART_Bg"><Setter Property="Background" Value="{DynamicResource CritBgBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  </ControlTheme>

  <!-- SC-4 · Tabs strip -->
  <ControlTheme x:Key="{x:Type c:Tabs}" TargetType="c:Tabs">
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Name="PART_Strip" Orientation="Horizontal" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SC-3 · DataTable (sortable header band + virtualized multi-select body) -->
  <ControlTheme x:Key="{x:Type c:DataTable}" TargetType="c:DataTable">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
            <Grid Name="PART_Header" />
          </Border>
          <ListBox Name="PART_Rows"
                   ItemsSource="{TemplateBinding ItemsSource}"
                   ItemTemplate="{TemplateBinding RowTemplate}"
                   SelectedItems="{Binding SelectedItems, RelativeSource={RelativeSource TemplatedParent}}"
                   SelectionMode="Multiple"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
