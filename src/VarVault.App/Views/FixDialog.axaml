<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             x:Class="VarVault.App.Views.FixDialog"
             x:DataType="vm:FixEncodingViewModel">
  <StackPanel Spacing="10" MinWidth="440">
    <TextBlock Text="Fix encoding → UTF-8" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
    <Grid ColumnDefinitions="*,*" >
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Before (mojibake)" Opacity="0.7" />
        <TextBlock Text="{Binding Before}" Foreground="{DynamicResource CritBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="After (UTF-8)" Opacity="0.7" />
        <TextBlock Text="{Binding After}" Foreground="{DynamicResource GoodBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <TextBlock Text="Writes a new UTF-8 var, validates it loads, keeps the original retained." Opacity="0.7" TextWrapping="Wrap" />
    <CheckBox Content="Also slim the var (drop redundant embedded content)" IsChecked="{Binding AlsoSlim}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Fix + apply to group" Command="{Binding FixCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
      <TextBlock Text="{Binding ResultMessage}" Opacity="0.8" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
