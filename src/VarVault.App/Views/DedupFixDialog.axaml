<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.DedupFixDialog"
             x:DataType="vm:DedupFixViewModel">
  <StackPanel Spacing="10" MinWidth="520" MaxWidth="720">
    <TextBlock Text="Fix duplicate zip entries" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource TextHiBrush}" />
    <TextBlock Text="{Binding VarName}" Opacity="0.85" FontFamily="{DynamicResource MonoFont}" FontSize="12"
               TextTrimming="CharacterEllipsis" />
    <TextBlock Text="VaM collapses paths case-insensitively. Pick which entry to keep per collision (keep-larger is the default)."
               Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
    <ScrollViewer MaxHeight="360">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DedupCollisionGroupViewModel">
            <Border Margin="0,0,0,10" Padding="8" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
              <StackPanel Spacing="6">
                <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="11" Opacity="0.8"
                           Text="{Binding NormalizedKey, StringFormat='Key: {0}'}" TextTrimming="CharacterEllipsis" />
                <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedKeep}" MaxHeight="140">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="lib:DuplicateEntryCandidate">
                      <Grid ColumnDefinitions="*,Auto" MinHeight="22">
                        <TextBlock Grid.Column="0" Text="{Binding FullName}"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Opacity="0.7" FontSize="11"
                                   VerticalAlignment="Center"
                                   Text="{Binding UncompressedSize, StringFormat='{}{0:N0} B'}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Apply (write .dedup.var)" Command="{Binding ApplyCommand}"
              Background="{DynamicResource AccentBrush}" Foreground="White" />
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" VerticalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="400" />
    </StackPanel>
  </StackPanel>
</UserControl>
