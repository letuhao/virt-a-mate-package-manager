<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.TrashView"
             x:DataType="vm:TrashViewModel">
  <DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="Trash &amp; backup" FontSize="21" FontWeight="SemiBold"
               Foreground="{DynamicResource TextHiBrush}" Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top" Text="Nothing is hard-deleted · catalog auto-backed-up"
               Foreground="{DynamicResource TextLoBrush}" Margin="0,0,0,12" />
    <c:Tabs DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Content="Back up now" Command="{Binding BackupNowCommand}" />
      <Button Content="Select page" Command="{Binding SelectPageCommand}" />
      <Button Content="Select all" Command="{Binding SelectAllCommand}" ToolTip.Tip="Select every item in trash (all pages), not just this page" />
      <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
      <Button Content="Restore selected" Command="{Binding RestoreSelectedCommand}" />
      <Button Content="Purge selected" Foreground="{DynamicResource CritBrush}" Command="{Binding PurgeSelectedCommand}" />
      <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" Opacity="0.7" VerticalAlignment="Center" />
      <TextBlock Text="{Binding TrashSummary}" Opacity="0.7" VerticalAlignment="Center" />
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Tab 0: Trash (recoverable) -->
    <DockPanel IsVisible="{Binding IsTrashTab}">
      <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                       PageNumber="{Binding Pager.PageNumber}"
                       PageCount="{Binding Pager.PageCount}"
                       PageSize="{Binding Pager.PageSize}"
                       TotalCount="{Binding Pager.TotalCount}"
                       SummaryLabel="{Binding Pager.SummaryLabel}"
                       PreviousCommand="{Binding PreviousPageCommand}"
                       NextCommand="{Binding NextPageCommand}"
                       GoToPageCommand="{Binding GoToPageCommand}"
                       PageSizeChangedCommand="{Binding ChangePageSizeCommand}" />
      <c:Card Header="Trash (recoverable)">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TrashRowViewModel">
              <Grid ColumnDefinitions="28,*,*,Auto,Auto,Auto,Auto" Height="26">
                <CheckBox Grid.Column="0" VerticalAlignment="Center" MinWidth="0"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding ((vm:TrashViewModel)DataContext).ToggleSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                <TextBlock Grid.Column="1" Text="{Binding OriginalPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Reason}" VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Grid.Column="3" Text="{Binding Bytes}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="{Binding TrashedAtUtc}" VerticalAlignment="Center" Opacity="0.5" FontSize="11" Margin="0,0,8,0" />
                <Button Grid.Column="5" Content="Restore"
                        Command="{Binding ((vm:TrashViewModel)DataContext).RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="6" Content="Purge" Margin="6,0,0,0" Foreground="{DynamicResource CritBrush}"
                        Command="{Binding ((vm:TrashViewModel)DataContext).PurgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </c:Card>
    </DockPanel>

    <!-- Tab 1: Catalog backups -->
    <c:Card Header="Catalog backups" IsVisible="{Binding IsBackupsTab}">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Backups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lib:BackupDto">
              <Grid ColumnDefinitions="*,Auto,Auto" Height="26">
                <TextBlock Grid.Column="0" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding CreatedAtUtc}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Bytes}" VerticalAlignment="Center" Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </c:Card>
  </DockPanel>
</UserControl>
