<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.PackageGalleryView"
             x:DataType="vm:PackageGalleryViewModel"
             Focusable="True">
  <Panel>
    <!-- Gallery (contact sheet) -->
    <DockPanel IsVisible="{Binding IsGalleryMode}">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <WrapPanel Orientation="Horizontal">
          <ToggleButton Content="Loadable" Margin="0,0,6,4" IsChecked="{Binding LoadableOnly, Mode=TwoWay}" Padding="8,3" FontSize="11" />
          <ComboBox Width="110" Margin="0,0,6,4" FontSize="11"
                    ItemsSource="{Binding TypeFilterOptions}"
                    SelectedItem="{Binding TypeFilter, Mode=TwoWay}" />
          <TextBlock Text="{Binding ImageCountLabel}" VerticalAlignment="Center" Opacity="0.7" FontSize="11" Margin="0,0,8,4" />
        </WrapPanel>
        <ComboBox ItemsSource="{Binding Copies}" SelectedValue="{Binding SelectedVarFileId}"
                  SelectedValueBinding="{Binding VarFileId}" MinHeight="28" FontSize="11"
                  IsVisible="{Binding HasCopies}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="lib:CopyDto">
              <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,6,0,0"
                       PageNumber="{Binding ContentPager.PageNumber}" PageCount="{Binding ContentPager.PageCount}"
                       PageSize="{Binding ContentPager.PageSize}" TotalCount="{Binding ContentPager.TotalCount}"
                       SummaryLabel="{Binding ContentPager.SummaryLabel}"
                       PreviousCommand="{Binding PreviousPageCommand}"
                       NextCommand="{Binding NextPageCommand}"
                       GoToPageCommand="{Binding GoToPageCommand}"
                       PageSizeChangedCommand="{Binding ChangePageSizeCommand}" />

      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Panel>
          <ItemsControl ItemsSource="{Binding Thumbs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryThumbViewModel">
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="3"
                        AttachedToVisualTree="OnThumbAttached"
                        Click="OnThumbClick">
                  <Border Width="108" Height="128" Padding="4" CornerRadius="4"
                          BorderBrush="#22808080" BorderThickness="1" Background="#10808080">
                    <Panel>
                      <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4"
                              IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Spacing="1" Margin="0,3,0,0">
                          <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" Opacity="0.85" />
                          <TextBlock Text="{Binding ShortName}" FontSize="10" Opacity="0.65"
                                     FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Panel>
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                          <TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" FontSize="9" Opacity="0.6"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"
                                     IsVisible="{Binding !HasThumbnail}" />
                          <c:Tag Content="pkg" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2"
                                 IsVisible="{Binding IsFallback}" />
                          <TextBlock Text="…" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.5"
                                     IsVisible="{Binding IsLoading}" FontSize="10" Margin="2" />
                        </Panel>
                      </DockPanel>
                    </Panel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No content items for this filter." HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.65" IsVisible="{Binding IsEmpty}" />
          <TextBlock Text="Loading gallery…" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.6" IsVisible="{Binding IsContentLoading}" />
        </Panel>
      </ScrollViewer>
    </DockPanel>

    <!-- Focus (light table) -->
    <DockPanel IsVisible="{Binding IsFocusMode}">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="← Gallery" Command="{Binding ExitFocusCommand}" Padding="8,3" FontSize="11" />
          <Button Content="⏮" Command="{Binding FocusFirstCommand}" Padding="6,3" FontSize="11" ToolTip.Tip="First" />
          <Button Content="◀" Command="{Binding FocusPreviousCommand}" Padding="6,3" FontSize="11"
                  IsEnabled="{Binding CanGoPrevious}" ToolTip.Tip="Previous" />
          <Button Content="▶" Command="{Binding FocusNextCommand}" Padding="6,3" FontSize="11"
                  IsEnabled="{Binding CanGoNext}" ToolTip.Tip="Next" />
          <Button Content="⏭" Command="{Binding FocusLastCommand}" Padding="6,3" FontSize="11" ToolTip.Tip="Last" />
          <TextBlock Text="{Binding FocusCounter}" VerticalAlignment="Center" Opacity="0.75" FontSize="11"
                     FontFamily="{DynamicResource MonoFont}" Margin="4,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding FocusType}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Text="{Binding FocusEntryPath}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                   Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FocusStatus}" FontSize="11" Opacity="0.7" IsVisible="{Binding FocusStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <c:Tag Content="lower-res fallback" IsVisible="{Binding FocusIsFallback}" />
      </StackPanel>

      <Border Background="#0C808080" CornerRadius="4" ClipToBounds="True" MinHeight="160">
        <Panel>
          <Image Source="{Binding FocusBitmap}" Stretch="Uniform"
                 IsVisible="{Binding FocusBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.6" IsVisible="{Binding IsFocusLoading}" />
          <TextBlock Text="{Binding FocusStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.65" TextWrapping="Wrap" Margin="12"
                     IsVisible="{Binding FocusBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
        </Panel>
      </Border>
    </DockPanel>
  </Panel>
</UserControl>
