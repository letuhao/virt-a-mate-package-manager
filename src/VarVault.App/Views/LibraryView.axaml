<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             xmlns:preset="clr-namespace:VarVault.Sdk.Presets;assembly=VarVault.Sdk"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="VarVault.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Focusable="True">
  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="360" MinWidth="220" MaxWidth="600" />
    </Grid.ColumnDefinitions>

    <!-- Rail -->
    <StackPanel Grid.Column="0" Margin="8" Spacing="4">
      <TextBlock Text="Library" FontWeight="Bold" Foreground="{DynamicResource TextLoBrush}" FontSize="10" Margin="4,0,0,6" />
      <Button Content="All packages" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowAllCommand}" />
      <Button Content="Favorites" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowFavoritesCommand}" />
      <Button Content="Active in game" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowActiveInGameCommand}" />
      <Button Content="Single copy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowSingleCopyCommand}" />
      <Button Content="Missing deps" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowMissingDepsCommand}" />

      <TextBlock Text="Tags" FontWeight="Bold" Foreground="{DynamicResource TextLoBrush}" FontSize="10" Margin="4,10,0,4" />
      <ItemsControl ItemsSource="{Binding Tags}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lib:TagInfo">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2" Background="Transparent" BorderThickness="0"
                    Command="{Binding ((vm:LibraryViewModel)DataContext).FilterByTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Id}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding PackageCount}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Padding="5,2" CornerRadius="4" Background="#2633D67F" IsVisible="{Binding HasActiveTag}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ActiveTagLabel}" FontSize="11" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="×" Padding="3,0" Command="{Binding ClearTagCommand}" />
        </Grid>
      </Border>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Watermark="new tag…" Text="{Binding NewTagName}" FontSize="11" />
        <Button Grid.Column="1" Content="+" Command="{Binding CreateTagCommand}" />
      </Grid>

      <TextBlock Text="Maintenance" FontWeight="Bold" Foreground="{DynamicResource TextLoBrush}" FontSize="10" Margin="4,10,0,4" />
      <Button Content="⚑ Batch fix encoding" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding GoCommand}" CommandParameter="health" />
      <Button Content="⧉ Find duplicates" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding GoCommand}" CommandParameter="dupes" />
      <Button Content="↕ Find stale / old" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding GoCommand}" CommandParameter="tiering" />
      <Button Content="⟳ Rebuild symlinks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding GoCommand}" CommandParameter="repos" />
    </StackPanel>

    <!-- Main -->
    <DockPanel Grid.Column="1" Margin="0,8">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <c:SearchableCombo Width="150" ItemsSource="{Binding CreatorOptions}" SelectedName="{Binding CreatorFilter}" Margin="0,0,8,6" />
        <TextBox x:Name="SearchBox" Width="240" MinWidth="180" Watermark="Search packages…" Text="{Binding SearchText}" Margin="0,0,8,6" />
        <TextBox Width="140" Watermark="packageName…" Text="{Binding PackageNameFilter}" Margin="0,0,8,6" />
        <CheckBox Content="Installed" VerticalAlignment="Center" IsChecked="{Binding InstalledOnly}" Margin="0,0,8,6" />
        <Button Content="Reset" Command="{Binding ResetFiltersCommand}" Margin="0,0,8,6" />
        <ComboBox Width="110" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortLabel}" Margin="0,0,8,6" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
        <Button Content="Table / Gallery" Command="{Binding ToggleViewModeCommand}" Margin="0,0,8,6" />
        <Button Content="Columns" Margin="0,0,8,6">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Creator" ToggleType="CheckBox" IsChecked="True" Tag="Creator" Click="OnColumnVisibilityClick" />
              <MenuItem Header="Type" ToggleType="CheckBox" IsChecked="True" Tag="Type" Click="OnColumnVisibilityClick" />
              <MenuItem Header="Size" ToggleType="CheckBox" IsChecked="True" Tag="Size" Click="OnColumnVisibilityClick" />
              <MenuItem Header="Tier" ToggleType="CheckBox" IsChecked="True" Tag="Tier" Click="OnColumnVisibilityClick" />
              <MenuItem Header="Copies" ToggleType="CheckBox" IsChecked="True" Tag="Copies" Click="OnColumnVisibilityClick" />
              <MenuItem Header="Dependencies" ToggleType="CheckBox" IsChecked="True" Tag="Dependencies" Click="OnColumnVisibilityClick" />
              <MenuItem Header="Added" ToggleType="CheckBox" IsChecked="True" Tag="Added" Click="OnColumnVisibilityClick" />
              <MenuItem Header="Installed" ToggleType="CheckBox" IsChecked="True" Tag="Installed" Click="OnColumnVisibilityClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </WrapPanel>

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <TextBlock Text="{Binding PositionLabel}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Text="~" IsVisible="{Binding IsCountApproximate}" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="6,6,0,0">
        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" VerticalAlignment="Center" Opacity="0.8" />
        <Button Content="Install" Command="{Binding InstallSelectedCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
        <Button Content="Uninstall" Command="{Binding UninstallSelectedCommand}" />
        <Button Content="Select all matching" Command="{Binding SelectAllMatchingCommand}" />
        <Button Content="Select loaded" Command="{Binding SelectVisibleCommand}" />
        <Button Content="★ Favorite" Command="{Binding FavoriteCheckedCommand}" />
        <Button Content="☆ Unfavorite" Command="{Binding UnfavoriteCheckedCommand}" />
        <Button Content="Delete" Foreground="{DynamicResource CritBrush}" Command="{Binding DeleteSelectedCommand}" />
        <Button Content="Fix encoding" Command="{Binding FixEncodingSelectedCommand}" />
        <ComboBox Width="140" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="preset:PresetInfo">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Add to preset" Command="{Binding AddToSelectedPresetCommand}" />
        <TextBox Width="120" Watermark="sub-folder…" Text="{Binding SubfolderName}" VerticalAlignment="Center" />
        <Button Content="Move to subfolder…" Command="{Binding MoveToSubfolderCommand}" />
        <TextBox Width="150" Watermark="paste package list…" Text="{Binding InstallTxtInput}" />
        <Button Content="Resolve txt" Command="{Binding InstallFromTxtCommand}" CommandParameter="{Binding InstallTxtInput}" />
        <Button Content="Export → txt" Command="{Binding ExportSelectedCommand}" />
        <TextBlock Text="{Binding LastActionMessage}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,6,0,0" Spacing="8">
        <Button Content="Load more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" IsEnabled="{Binding !IsLoadingMore}" />
        <TextBlock Text="Loading more…" IsVisible="{Binding IsLoadingMore}" VerticalAlignment="Center" Opacity="0.7" />
        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} packages'}" Opacity="0.7" VerticalAlignment="Center" />
      </StackPanel>

      <Panel Margin="6,4">
        <dg:DataGrid x:Name="PackageGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedEntry}"
                     AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                     CanUserSortColumns="True" GridLinesVisibility="Horizontal" IsVisible="{Binding IsTableView}"
                     HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Extended"
                     SelectionChanged="OnGridSelectionChanged" Sorting="OnGridSorting"
                     ColumnReordered="OnGridColumnReordered">
          <dg:DataGrid.Columns>
            <dg:DataGridTemplateColumn Header="" Width="28" SortMemberPath="Selection">
              <dg:DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="lib:PackageListEntry">
                  <CheckBox IsChecked="{Binding $parent[dg:DataGridRow].IsSelected, Mode=TwoWay}" />
                </DataTemplate>
              </dg:DataGridTemplateColumn.CellTemplate>
            </dg:DataGridTemplateColumn>
            <dg:DataGridTextColumn Header="Package" SortMemberPath="Name" Binding="{Binding VarName}" Width="*" MinWidth="120" />
            <dg:DataGridTextColumn Header="Creator" SortMemberPath="Creator" Binding="{Binding Creator}" Width="110" />
            <dg:DataGridTextColumn Header="Type" SortMemberPath="Type" Binding="{Binding PrimaryType}" Width="70" />
            <dg:DataGridTextColumn Header="Size" SortMemberPath="Size" Binding="{Binding TotalSize, Converter={StaticResource BytesToSize}}" Width="64" />
            <dg:DataGridTextColumn Header="Tier" SortMemberPath="Tier" Binding="{Binding Tier, StringFormat='T{0}'}" Width="40" />
            <dg:DataGridTextColumn Header="Cop" SortMemberPath="Copies" Binding="{Binding OnlineInstanceCount}" Width="36" />
            <dg:DataGridTextColumn Header="Dep" SortMemberPath="Dependencies" Binding="{Binding DependencyCount}" Width="36" />
            <dg:DataGridTextColumn Header="Added" SortMemberPath="Added" Binding="{Binding AddedAt, StringFormat='{}{0:MM/dd/yy}'}" Width="54" />
            <dg:DataGridTextColumn Header="Installed" SortMemberPath="Installed" Binding="{Binding InstalledAt, StringFormat='{}{0:MM/dd/yy}'}" Width="54" />
            <dg:DataGridTemplateColumn Header="" Width="104" SortMemberPath="Actions">
              <dg:DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="lib:PackageListEntry">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button Content="Fix" Padding="5,1" FontSize="10"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).FixRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Detail" Padding="5,1" FontSize="10"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </dg:DataGridTemplateColumn.CellTemplate>
            </dg:DataGridTemplateColumn>
          </dg:DataGrid.Columns>
        </dg:DataGrid>

        <ListBox x:Name="GalleryList" ItemsSource="{Binding GalleryItems}" IsVisible="{Binding IsGalleryView}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GalleryCardViewModel">
              <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                      AttachedToVisualTree="OnGalleryCardAttached"
                      Command="{Binding ((vm:LibraryViewModel)DataContext).SelectEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Entry}">
                <Border Width="150" Height="164" Margin="4" Padding="8" CornerRadius="6"
                        BorderBrush="#22808080" BorderThickness="1">
                  <Panel>
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="6"
                            IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                    <StackPanel Spacing="4">
                      <Panel Height="90">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                        <Border Background="#18808080" CornerRadius="4" IsVisible="{Binding !HasThumbnail}">
                          <TextBlock Text="{Binding PrimaryType}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                        </Border>
                        <Border Background="#2633D67F" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3" IsVisible="{Binding IsActive}">
                          <TextBlock Text="installed" FontSize="9" Foreground="#3DDC97" />
                        </Border>
                      </Panel>
                      <TextBlock Text="{Binding PackageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Creator}" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.75" FontFamily="{DynamicResource MonoFont}" />
                    </StackPanel>
                  </Panel>
                </Border>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="No packages match your filters." HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.7" IsVisible="{Binding IsEmpty}" />
      </Panel>
    </DockPanel>

    <GridSplitter Grid.Column="2" Width="5" ResizeDirection="Columns" Background="{DynamicResource BorderBrush}" />

    <Border Grid.Column="3" Margin="8" Padding="12"
            BorderBrush="#22808080" BorderThickness="1" CornerRadius="6"
            IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">
        <StackPanel DataContext="{Binding SelectedEntry}" x:DataType="lib:PackageListEntry" Spacing="6">
          <TextBlock Text="{Binding VarName}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Creator, StringFormat='by {0}'}" Opacity="0.8" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <c:Tag Content="{Binding StorageClass}" />
            <c:Tag Content="★ favorite" Kind="Warn" IsVisible="{Binding IsFavorite}" />
            <c:Tag Content="installed" Kind="Good" IsVisible="{Binding IsActive}" />
          </StackPanel>
          <TextBlock Text="{Binding InstalledAt, StringFormat='Installed: {0:yyyy-MM-dd}'}" Opacity="0.8" IsVisible="{Binding IsActive}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="★ Favorite" Command="{Binding ToggleFavoriteCommand}" />
          <Button Content="⌖ Locate" Command="{Binding LocateCommand}" />
        </StackPanel>
        <Border Height="118" CornerRadius="4" Background="#18808080" IsVisible="{Binding HasSelectedThumbnail}" ClipToBounds="True">
          <Image Source="{Binding SelectedThumbnail}" Stretch="UniformToFill" />
        </Border>
        <StackPanel DataContext="{Binding SelectedDetail}" x:DataType="lib:PackageDetail" Spacing="2"
                    IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding DependedOnByCount, StringFormat='depended on by {0}'}" Opacity="0.8" FontSize="12" />
        </StackPanel>
        <Button Content="Open full detail →" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                Command="{Binding OpenDetailCommand}" CommandParameter="{Binding SelectedEntry}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
