<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             xmlns:preset="clr-namespace:VarVault.Sdk.Presets;assembly=VarVault.Sdk"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             x:Class="VarVault.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <Grid ColumnDefinitions="180,*,280">

    <!-- Rail: saved views (SCR-2a) -->
    <StackPanel Grid.Column="0" Margin="8" Spacing="4">
      <TextBlock Text="Library" FontWeight="Bold" Foreground="{DynamicResource TextLoBrush}" FontSize="10" Margin="4,0,0,6" />
      <Button Content="All packages" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowAllCommand}" />
      <Button Content="Favorites" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowFavoritesCommand}" />
      <Button Content="Active in game" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowActiveInGameCommand}" />
      <Button Content="Single copy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowSingleCopyCommand}" />
      <Button Content="Missing deps" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ShowMissingDepsCommand}" />

      <TextBlock Text="Tags" FontWeight="Bold" Foreground="{DynamicResource TextLoBrush}" FontSize="10" Margin="4,10,0,4" />
      <ItemsControl ItemsSource="{Binding Tags}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lib:TagInfo">
            <Grid ColumnDefinitions="*,Auto" Height="22">
              <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding PackageCount}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Watermark="new tag…" Text="{Binding NewTagName}" FontSize="11" />
        <Button Grid.Column="1" Content="+" Command="{Binding CreateTagCommand}" />
      </Grid>

      <TextBlock Text="Maintenance" FontWeight="Bold" Foreground="{DynamicResource TextLoBrush}" FontSize="10" Margin="4,10,0,4" />
      <Button Content="⚑ Batch fix encoding" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding GoCommand}" CommandParameter="health" />
      <Button Content="⧉ Find duplicates" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding GoCommand}" CommandParameter="dupes" />
      <Button Content="↕ Find stale / old" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding GoCommand}" CommandParameter="tiering" />
      <Button Content="⟳ Rebuild symlinks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding GoCommand}" CommandParameter="repos" />

      <TextBlock Text="Dependency analysis" FontWeight="Bold" Foreground="{DynamicResource TextLoBrush}" FontSize="10" Margin="4,10,0,4" />
      <Button Content="⚠ Scan missing deps" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding GoCommand}" CommandParameter="missing" />
      <Button Content="◱ Analyze proposals" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding GoCommand}" CommandParameter="proposals" />
    </StackPanel>

    <!-- Center: facet + list + ops -->
    <DockPanel Grid.Column="1" Margin="0,8">
      <!-- Facet bar (SCR-2b) -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
        <c:SearchableCombo Grid.Column="0" Width="150"
                           ItemsSource="{Binding CreatorOptions}" SelectedName="{Binding CreatorFilter}" />
        <TextBox Grid.Column="1" Margin="8,0" Watermark="Search packages…" Text="{Binding SearchText}" />
        <TextBox Grid.Column="2" Width="120" Watermark="packageName…" Text="{Binding PackageNameFilter}" />
        <CheckBox Grid.Column="3" Margin="8,0" Content="Installed" IsChecked="{Binding InstalledOnly}" />
        <Button Grid.Column="4" Content="Reset" Command="{Binding ResetFiltersCommand}" />
        <ComboBox Grid.Column="5" Margin="8,0,0,0" Width="110" ItemsSource="{Binding SortOptions}"
                  SelectedItem="{Binding SelectedSortLabel}" />
        <Button Grid.Column="6" Margin="6,0,0,0" Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Grid.Column="7" Margin="6,0,0,0" Content="Table / Gallery" Command="{Binding ToggleViewModeCommand}" />
      </Grid>
      <!-- Filter chips + position (AC-10) -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="10" Padding="8,2" IsVisible="{Binding CreatorFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding CreatorFilter, StringFormat='creator: {0}'}" FontSize="11" VerticalAlignment="Center" />
            <Button Content="✕" Padding="2,0" FontSize="10" Command="{Binding ResetFiltersCommand}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding PositionLabel}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Column headers (sortable, SCR-2c) -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="28,*,140,90,70,50,60,40,60,60,70" Margin="6,0">
        <TextBlock Grid.Column="0" Text="" />
        <Button Grid.Column="1" Content="{Binding NameHeader}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Command="{Binding SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Name}" />
        <Button Grid.Column="2" Content="{Binding CreatorHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Creator}" />
        <TextBlock Grid.Column="3" Text="Type" VerticalAlignment="Center" Opacity="0.7" />
        <Button Grid.Column="4" Content="{Binding SizeHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Size}" />
        <TextBlock Grid.Column="5" Text="Tier" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" />
        <Button Grid.Column="6" Content="{Binding ClassHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Class}" />
        <TextBlock Grid.Column="7" Text="Cop" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" />
        <TextBlock Grid.Column="8" Text="State" VerticalAlignment="Center" Opacity="0.7" />
        <TextBlock Grid.Column="9" Text="Fix" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" />
        <TextBlock Grid.Column="10" Text="" />
      </Grid>

      <!-- Ops bar (SCR-2e) -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="6,6,0,0">
        <TextBlock Text="{Binding SelectedItems.Count, StringFormat='{}{0} selected'}" VerticalAlignment="Center" Opacity="0.8" />
        <!-- Bulk activate/deactivate (doc 26 · G-5) -->
        <Button Content="Install" Command="{Binding InstallSelectedCommand}"
                Background="{DynamicResource AccentBrush}" Foreground="White"
                ToolTip.Tip="Materialize per-var symlinks for the selected packages (Library installs profile)" />
        <Button Content="Uninstall" Command="{Binding UninstallSelectedCommand}"
                ToolTip.Tip="Remove the selected packages' symlinks" />
        <Button Content="{Binding TotalCount, StringFormat='select all {0} matching'}" Command="{Binding SelectAllMatchingCommand}" />
        <Button Content="Add to preset…">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding Presets}">
              <MenuFlyout.ItemTemplate>
                <DataTemplate x:DataType="preset:PresetInfo">
                  <MenuItem Header="{Binding Name}"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).AddToPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}" />
                </DataTemplate>
              </MenuFlyout.ItemTemplate>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Content="Delete" Foreground="{DynamicResource CritBrush}" Command="{Binding DeleteSelectedCommand}" />
        <Button Content="Fix encoding" Command="{Binding FixEncodingSelectedCommand}" />
        <TextBox Width="120" Watermark="sub-folder…" Text="{Binding SubfolderName}" VerticalAlignment="Center" />
        <Button Content="Move to subfolder…" Command="{Binding MoveToSubfolderCommand}" />
        <Button Content="Export → txt" Command="{Binding ExportSelectedCommand}" />
        <TextBox Width="120" Watermark="paste txt list…" Text="{Binding InstallTxtInput}" VerticalAlignment="Center" />
        <Button Content="Install from txt" Command="{Binding InstallFromTxtCommand}" CommandParameter="{Binding InstallTxtInput}" />
        <TextBlock Text="{Binding LastActionMessage}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>

      <!-- Status -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,6,0,0" Opacity="0.7">
        <TextBlock Text="~" IsVisible="{Binding IsCountApproximate}" />
        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} packages'}" />
      </StackPanel>

      <!-- Content -->
      <Panel Margin="6,4">
        <!-- Table view: header + per-content-type columns (Sc/Lk/Cl/Hr/Pl/As/Mo/Po/Sk) + Cop/Dep/Added/Used. (doc 26 · G-2.1/2.2/2.3) -->
        <DockPanel IsVisible="{Binding IsTableView}">
          <Grid DockPanel.Dock="Top" Height="22" Margin="0,0,0,2"
                ColumnDefinitions="28,*,110,30,30,30,30,30,30,30,30,30,64,40,36,40,54,52,50,46,56">
            <Grid.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </Grid.Styles>
            <TextBlock Grid.Column="1" Text="Package" />
            <TextBlock Grid.Column="2" Text="Creator" />
            <TextBlock Grid.Column="3" Text="Sc" HorizontalAlignment="Center" ToolTip.Tip="Scenes" />
            <TextBlock Grid.Column="4" Text="Lk" HorizontalAlignment="Center" ToolTip.Tip="Looks" />
            <TextBlock Grid.Column="5" Text="Cl" HorizontalAlignment="Center" ToolTip.Tip="Clothing" />
            <TextBlock Grid.Column="6" Text="Hr" HorizontalAlignment="Center" ToolTip.Tip="Hair" />
            <TextBlock Grid.Column="7" Text="Pl" HorizontalAlignment="Center" ToolTip.Tip="Plugins" />
            <TextBlock Grid.Column="8" Text="As" HorizontalAlignment="Center" ToolTip.Tip="Assets" />
            <TextBlock Grid.Column="9" Text="Mo" HorizontalAlignment="Center" ToolTip.Tip="Morphs" />
            <TextBlock Grid.Column="10" Text="Po" HorizontalAlignment="Center" ToolTip.Tip="Poses" />
            <TextBlock Grid.Column="11" Text="Sk" HorizontalAlignment="Center" ToolTip.Tip="Skins" />
            <TextBlock Grid.Column="12" Text="Size" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="13" Text="Tier" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="14" Text="Cop" HorizontalAlignment="Center" ToolTip.Tip="Copies" />
            <TextBlock Grid.Column="15" Text="Dep" HorizontalAlignment="Center" ToolTip.Tip="Dependencies" />
            <TextBlock Grid.Column="16" Text="State" />
            <TextBlock Grid.Column="17" Text="Added" />
            <TextBlock Grid.Column="18" Text="Used" />
            <TextBlock Grid.Column="19" Text="Fix" />
          </Grid>
          <ListBox ItemsSource="{Binding Items}" SelectionMode="Multiple" SelectedItem="{Binding SelectedEntry}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="lib:PackageListEntry">
                <Grid Height="26"
                      ColumnDefinitions="28,*,110,30,30,30,30,30,30,30,30,30,64,40,36,40,54,52,50,46,56">
                  <Grid.Styles>
                    <Style Selector="TextBlock.ct">
                      <Setter Property="HorizontalAlignment" Value="Center" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="Opacity" Value="0.55" />
                      <Setter Property="FontSize" Value="11" />
                      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                    </Style>
                  </Grid.Styles>
                  <CheckBox Grid.Column="0" VerticalAlignment="Center" MinWidth="0"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).ToggleSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  <TextBlock Grid.Column="1" Text="{Binding VarName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Creator}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Classes="ct" Text="{Binding Scenes}" />
                  <TextBlock Grid.Column="4" Classes="ct" Text="{Binding Looks}" />
                  <TextBlock Grid.Column="5" Classes="ct" Text="{Binding Clothing}" />
                  <TextBlock Grid.Column="6" Classes="ct" Text="{Binding Hair}" />
                  <TextBlock Grid.Column="7" Classes="ct" Text="{Binding Plugins}" />
                  <TextBlock Grid.Column="8" Classes="ct" Text="{Binding Assets}" />
                  <TextBlock Grid.Column="9" Classes="ct" Text="{Binding Morphs}" />
                  <TextBlock Grid.Column="10" Classes="ct" Text="{Binding Poses}" />
                  <TextBlock Grid.Column="11" Classes="ct" Text="{Binding Skins}" />
                  <TextBlock Grid.Column="12" Text="{Binding TotalSize}" VerticalAlignment="Center" Opacity="0.85" HorizontalAlignment="Right" FontFamily="{DynamicResource MonoFont}" />
                  <TextBlock Grid.Column="13" Text="{Binding Tier, StringFormat='T{0}'}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85" />
                  <TextBlock Grid.Column="14" Text="{Binding OnlineInstanceCount}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" FontFamily="{DynamicResource MonoFont}" />
                  <TextBlock Grid.Column="15" Text="{Binding DependencyCount}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" FontFamily="{DynamicResource MonoFont}" />
                  <c:StatePill Grid.Column="16" State="Miss" Text="missing" IsVisible="{Binding HasMissingDeps}" VerticalAlignment="Center" />
                  <c:StatePill Grid.Column="16" State="Ok" Text="ok" IsVisible="{Binding !HasMissingDeps}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="17" Text="{Binding AddedAt, StringFormat='{}{0:MM/dd/yy}'}" VerticalAlignment="Center" Opacity="0.7" FontSize="11" FontFamily="{DynamicResource MonoFont}" />
                  <TextBlock Grid.Column="18" Text="{Binding LastUsedAt, StringFormat='{}{0:MM/dd/yy}'}" VerticalAlignment="Center" Opacity="0.7" FontSize="11" FontFamily="{DynamicResource MonoFont}" />
                  <Button Grid.Column="19" Content="Fix" Padding="5,1" FontSize="10"
                          Command="{Binding ((vm:LibraryViewModel)DataContext).FixRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="20" Content="Detail" Padding="5,1" FontSize="10"
                          Command="{Binding ((vm:LibraryViewModel)DataContext).OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <ListBox ItemsSource="{Binding GalleryItems}" SelectionMode="Multiple"
                 IsVisible="{Binding IsGalleryView}">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GalleryCardViewModel">
              <Border Width="150" Height="164" Margin="4" Padding="8" BorderBrush="#22808080" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="4">
                  <Panel Height="90">
                    <!-- Extracted preview thumbnail (from the packed thumbnail store) -->
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                    <!-- Type placeholder until/unless a preview was extracted -->
                    <Border Background="#18808080" CornerRadius="4" IsVisible="{Binding !HasThumbnail}">
                      <TextBlock Text="{Binding PrimaryType}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                    </Border>
                    <!-- Badges: tier / missing / favorite (top-right) + installed (bottom-left). (doc 26 · G-3) -->
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3">
                      <Border Background="#B0000000" CornerRadius="3" Padding="4,1"
                              IsVisible="{Binding TierLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding TierLabel}" FontSize="9" Foreground="White" FontFamily="{DynamicResource MonoFont}" />
                      </Border>
                      <Border Background="#FB6F84" CornerRadius="3" Padding="4,1" IsVisible="{Binding HasMissingDeps}">
                        <TextBlock Text="!" FontSize="9" Foreground="White" />
                      </Border>
                      <Border Background="#B0000000" CornerRadius="3" Padding="4,1" IsVisible="{Binding IsFavorite}">
                        <TextBlock Text="★" FontSize="9" Foreground="#F4B740" />
                      </Border>
                    </StackPanel>
                    <Border Background="#2633D67F" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="3" IsVisible="{Binding IsActive}">
                      <TextBlock Text="installed" FontSize="9" Foreground="#3DDC97" />
                    </Border>
                  </Panel>
                  <TextBlock Text="{Binding PackageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Creator}" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <!-- Meta: type · class · size (+ single-copy marker). (doc 26 · G-3) -->
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="11" Opacity="0.75" FontFamily="{DynamicResource MonoFont}" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding PrimaryType}" FontSize="11" Opacity="0.7" />
                      <TextBlock Text="{Binding StorageClass}" FontSize="10" Opacity="0.5" VerticalAlignment="Center" />
                      <TextBlock Text="◆" FontSize="10" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding IsSingleCopy}" ToolTip.Tip="Single copy" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="No packages match your filters." HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.7" IsVisible="{Binding IsEmpty}" />
      </Panel>
    </DockPanel>

    <!-- Detail panel (SCR-2f) -->
    <Border Grid.Column="2" Margin="8" Padding="12" BorderBrush="#22808080" BorderThickness="1" CornerRadius="6"
            IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">
        <StackPanel DataContext="{Binding SelectedEntry}" x:DataType="lib:PackageListEntry" Spacing="6">
          <TextBlock Text="{Binding VarName}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Creator, StringFormat='by {0}'}" Opacity="0.8" />
          <!-- Tag row (class / installed / favorite) -->
          <StackPanel Orientation="Horizontal" Spacing="5">
            <c:Tag Content="{Binding StorageClass}" />
            <c:Tag Content="★ favorite" Kind="Warn" IsVisible="{Binding IsFavorite}" />
          </StackPanel>
          <TextBlock Text="{Binding PrimaryType, StringFormat='Type: {0}'}" Opacity="0.8" />
          <TextBlock Text="{Binding ContentSummary, StringFormat='Contents: {0}'}" Opacity="0.8"
                     IsVisible="{Binding ContentSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding OnlineInstanceCount, StringFormat='Online copies: {0}'}" Opacity="0.8" />
          <TextBlock Text="Single copy — protected" Opacity="0.8" IsVisible="{Binding IsSingleCopy}" Foreground="{DynamicResource WarnBrush}" />
          <TextBlock Text="Missing dependencies" Foreground="{DynamicResource CritBrush}" IsVisible="{Binding HasMissingDeps}" />
        </StackPanel>
        <!-- Actions grid (AC-13) -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="★ Favorite" Command="{Binding ToggleFavoriteCommand}" />
          <Button Content="⌖ Locate" Command="{Binding LocateCommand}" />
          <Button Content="Resolve via alias →" Command="{Binding ResolveAliasCommand}"
                  IsVisible="{Binding SelectedEntry.HasMissingDeps}" />
        </StackPanel>

        <!-- Content previews (doc 26 · G-2.4): hero thumbnail + content-item strip. -->
        <TextBlock Text="Content previews" FontWeight="SemiBold" Margin="0,6,0,0"
                   IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border Height="118" CornerRadius="4" Background="#18808080" IsVisible="{Binding HasSelectedThumbnail}" ClipToBounds="True">
          <Image Source="{Binding SelectedThumbnail}" Stretch="UniformToFill" />
        </Border>
        <ItemsControl ItemsSource="{Binding SelectedDetail.ContentItems}"
                      IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lib:ContentItemDto">
              <Border Width="72" Height="54" Margin="0,2,4,2" CornerRadius="4" Background="#18808080" Padding="4">
                <Grid>
                  <TextBlock Text="L" FontSize="8" FontWeight="Bold" Foreground="#3DDC97"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             IsVisible="{Binding IsPreset}" ToolTip.Tip="Loadable preset" />
                  <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Type}" FontSize="9" Opacity="0.85" />
                    <TextBlock Text="{Binding EntryPath}" FontSize="8" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Dependencies (AC-13) -->
        <TextBlock Text="Dependencies" FontWeight="SemiBold" Margin="0,6,0,0"
                   IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel DataContext="{Binding SelectedDetail}" x:DataType="lib:PackageDetail" Spacing="2"
                    IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding ForwardClosure.Count, StringFormat='depends on {0} package(s)'}" Opacity="0.8" FontSize="12" />
          <TextBlock Text="{Binding DependedOnByCount, StringFormat='depended on by {0}'}" Opacity="0.8" FontSize="12" />
        </StackPanel>

        <!-- Copies list (AC-13) -->
        <TextBlock Text="Copies" FontWeight="SemiBold" Margin="0,6,0,0"
                   IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ItemsControl ItemsSource="{Binding SelectedDetail.Copies}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lib:CopyDto">
              <Grid ColumnDefinitions="Auto,*,Auto" Height="22">
                <c:Tag Grid.Column="0" Content="{Binding Tier, StringFormat='T{0}'}" />
                <TextBlock Grid.Column="1" Text="{Binding Path}" Opacity="0.75" FontSize="11" Margin="6,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <c:StatePill Grid.Column="2" State="Ok" Text="online" IsVisible="{Binding IsOnline}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Open full detail →" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                Command="{Binding OpenDetailCommand}" CommandParameter="{Binding SelectedEntry}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
