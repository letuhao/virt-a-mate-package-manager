<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.HealthView"
             x:DataType="vm:HealthViewModel">
  <DockPanel Margin="18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="Health &amp; fix" FontSize="21" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Fix all detected…" Command="{Binding FixAllCommand}"
              Background="{DynamicResource AccentBrush}" Foreground="White" />
    </Grid>
    <c:Tabs DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,12" />

    <!-- One panel per tab; only the active tab renders. (24-checklist A1/A3/A4) -->
    <Grid>
      <!-- Encoding (tab 0) -->
      <DockPanel IsVisible="{Binding IsEncodingTab}">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <c:Card Header="GBK / GB2312" Width="180" Margin="0,0,10,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding GbkCount}" FontSize="24" Foreground="{DynamicResource CritBrush}" />
              <Button Content="Fix GBK…" Command="{Binding FixAllCommand}" />
            </StackPanel>
          </c:Card>
          <c:Card Header="Shift-JIS" Width="180" Margin="0,0,10,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ShiftJisCount}" FontSize="24" Foreground="{DynamicResource WarnBrush}" />
              <Button Content="Fix Shift-JIS…" Command="{Binding FixAllCommand}" />
            </StackPanel>
          </c:Card>
          <c:Card Header="Other / low-confidence" Width="180">
            <TextBlock Text="{Binding OtherEncodingCount}" FontSize="24" Foreground="{DynamicResource TextLoBrush}" />
          </c:Card>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="No encoding issues detected." Opacity="0.6" IsVisible="{Binding IsEmpty}" Margin="0,8,0,0" />
        <c:Card Header="Encoding — fixable groups">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding EncodingGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="lib:EncodingGroup">
                  <Grid ColumnDefinitions="*,Auto,Auto" Height="28">
                    <TextBlock Grid.Column="0" Text="{Binding Codepage}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Count}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Grid.Column="2" Content="Fix group…"
                            Command="{Binding ((vm:HealthViewModel)DataContext).FixGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" />
          </StackPanel>
        </c:Card>
      </DockPanel>

      <!-- Integrity / corrupt (tab 1) -->
      <DockPanel IsVisible="{Binding IsIntegrityTab}">
        <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                         PageNumber="{Binding IntegrityPager.PageNumber}"
                         PageCount="{Binding IntegrityPager.PageCount}"
                         PageSize="{Binding IntegrityPager.PageSize}"
                         TotalCount="{Binding IntegrityPager.TotalCount}"
                         SummaryLabel="{Binding IntegrityPager.SummaryLabel}"
                         PreviousCommand="{Binding IntegrityPreviousPageCommand}"
                         NextCommand="{Binding IntegrityNextPageCommand}"
                         GoToPageCommand="{Binding IntegrityGoToPageCommand}"
                         PageSizeChangedCommand="{Binding IntegrityChangePageSizeCommand}" />
        <c:Card Header="Integrity / corrupt vars">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Integrity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lib:IntegrityIssue">
                <Grid ColumnDefinitions="*,2*" Height="24">
                  <TextBlock Grid.Column="0" Text="{Binding VarName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding RelativePath}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </c:Card>
      </DockPanel>

      <!-- Missing meta (tab 2) — 24-checklist A4 -->
      <DockPanel IsVisible="{Binding IsMissingMetaTab}">
        <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                         PageNumber="{Binding MissingMetaPager.PageNumber}"
                         PageCount="{Binding MissingMetaPager.PageCount}"
                         PageSize="{Binding MissingMetaPager.PageSize}"
                         TotalCount="{Binding MissingMetaPager.TotalCount}"
                         SummaryLabel="{Binding MissingMetaPager.SummaryLabel}"
                         PreviousCommand="{Binding MissingMetaPreviousPageCommand}"
                         NextCommand="{Binding MissingMetaNextPageCommand}"
                         GoToPageCommand="{Binding MissingMetaGoToPageCommand}"
                         PageSizeChangedCommand="{Binding MissingMetaChangePageSizeCommand}" />
        <c:Card Header="Missing meta.json">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding MissingMeta}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lib:IntegrityIssue">
                <Grid ColumnDefinitions="*,2*" Height="24">
                  <TextBlock Grid.Column="0" Text="{Binding VarName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding RelativePath}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </c:Card>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
