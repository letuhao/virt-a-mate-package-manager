<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.ProposalsView"
             x:DataType="vm:ProposalsViewModel">
  <DockPanel Margin="18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
      <TextBlock Grid.Column="0" Text="Proposals &amp; review" FontSize="21" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Reject all" Margin="0,0,8,0" Command="{Binding RejectAllCommand}" />
      <Button Grid.Column="2" Content="Approve selected" Command="{Binding ApproveSelectedCommand}"
              Background="{DynamicResource AccentBrush}" Foreground="White" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource TextLoBrush}" Margin="0,0,0,12"
               Text="Nothing runs unattended. The analyzer proposes; you approve." />
    <c:Tabs DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,12" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding VisibleProposals}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProposalRowViewModel">
            <c:Card Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" >
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
                  <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12" />
                </StackPanel>
                <c:Tag Grid.Column="3" Content="{Binding Tag}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Review…" Margin="0,0,8,0"
                        Command="{Binding ((vm:ProposalsViewModel)DataContext).ReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="5" Content="Reject" Margin="0,0,8,0"
                        Command="{Binding ((vm:ProposalsViewModel)DataContext).RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="6" Content="Approve" Background="{DynamicResource AccentBrush}" Foreground="White"
                        Command="{Binding ((vm:ProposalsViewModel)DataContext).ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </Grid>
            </c:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
