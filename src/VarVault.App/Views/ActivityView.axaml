<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:act="clr-namespace:VarVault.Sdk.Activation;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
  <DockPanel Margin="18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="Activity history" FontSize="21" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="140" />
    </Grid>
    <c:Card Header="Audit log">
      <Panel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="act:ActivityRecord">
                <Grid ColumnDefinitions="120,90,*" Height="24">
                  <TextBlock Grid.Column="0" Text="{Binding AtUtc}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" Opacity="0.85" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- 28-checklist B2.1 · empty-state so a fresh install shows guidance, not a blank card -->
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Margin="0,40">
          <TextBlock Text="No activity yet" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
          <TextBlock Text="Actions you take — installs, migrations, fixes, deletes — will appear here."
                     HorizontalAlignment="Center" Opacity="0.6" FontSize="12" />
        </StackPanel>
      </Panel>
    </c:Card>
  </DockPanel>
</UserControl>
