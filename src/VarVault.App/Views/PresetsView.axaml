<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:p="clr-namespace:VarVault.Sdk.Presets;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.PresetsView"
             x:DataType="vm:PresetsViewModel">
  <DockPanel Margin="18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="Loading presets" FontSize="21" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Import from txt…" Command="{Binding ImportTxtCommand}" />
        <Button Content="+ New preset" Command="{Binding NewPresetCommand}"
                Background="{DynamicResource AccentBrush}" Foreground="White" />
      </StackPanel>
    </Grid>
    <!-- AddonPackages profile switcher (doc 26 · G-6) -->
    <c:Card DockPanel.Dock="Top" Margin="0,0,0,12" Header="AddonPackages profile"
            IsVisible="{Binding VamPathConfigured}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Active:" Opacity="0.6" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ActiveProfile, TargetNullValue='(none)'}" FontWeight="SemiBold"
                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="160" />
        <Button Content="Switch" Command="{Binding SwitchProfileCommand}" />
        <TextBox Width="130" Watermark="new / rename…" Text="{Binding NewProfileName}" VerticalAlignment="Center" />
        <Button Content="Add" Command="{Binding AddProfileCommand}" />
        <Button Content="Rename" Command="{Binding RenameProfileCommand}" />
        <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Foreground="{DynamicResource CritBrush}" />
      </StackPanel>
    </c:Card>
    <Grid ColumnDefinitions="260,*">
      <ListBox Grid.Column="0" ItemsSource="{Binding Presets}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="p:PresetInfo">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Name}" />
              <TextBlock Grid.Column="1" Text="{Binding MemberCount}" Opacity="0.6" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 28-checklist B2.2 · empty-state so a fresh install shows a CTA, not a blank pane -->
      <StackPanel Grid.Column="1" Margin="16,0,0,0" IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="No loading presets yet" HorizontalAlignment="Center" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextHiBrush}" />
        <TextBlock Text="A preset is a named set of packages you activate into VaM together."
                   HorizontalAlignment="Center" Opacity="0.6" FontSize="12" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" />
        <Button Content="+ New preset" Command="{Binding NewPresetCommand}" HorizontalAlignment="Center"
                Background="{DynamicResource AccentBrush}" Foreground="White" />
      </StackPanel>

      <c:Card Grid.Column="1" Margin="16,0,0,0" Header="Preset detail"
              IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
            <Button Content="Edit" Command="{Binding EditCommand}" />
            <Button Content="Diff" Command="{Binding DiffCommand}" />
            <Button Content="Export" Command="{Binding ExportCommand}" />
          </StackPanel>
          <TextBlock Opacity="0.8" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding Preview.TotalWithClosure, StringFormat='{}{0} packages with closure'}" />
          <TextBlock Opacity="0.8" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding Preview.MissingRefs.Count, StringFormat='{}{0} missing'}" />
          <!-- Member table (GD-8) -->
          <TextBlock Text="Members" FontSize="10" Opacity="0.6" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{Binding Members}" MaxHeight="240">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PresetMemberRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                  <TextBlock Grid.Column="0" Text="{Binding Ref}" FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                  <c:StatePill Grid.Column="1" State="Miss" Text="missing" IsVisible="{Binding IsMissing}" />
                  <c:StatePill Grid.Column="1" State="Ok" Text="ok" IsVisible="{Binding !IsMissing}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="Activate &amp; switch" Command="{Binding ActivateAndSwitchCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    ToolTip.Tip="Materialize per-var symlinks for this preset, then point VaM at it" />
            <Button Content="Activate" Command="{Binding ActivateCommand}"
                    ToolTip.Tip="Materialize per-var symlinks under this preset's profile (no switch)" />
            <Button Content="Switch only" Command="{Binding SwitchCommand}"
                    ToolTip.Tip="Repoint AddonPackages to this profile without rebuilding links" />
            <Button Content="Deactivate all" Command="{Binding DeactivateAllCommand}" />
          </StackPanel>
          <TextBlock Text="Set the VaM install path in Settings to enable activation."
                     Opacity="0.7" FontSize="12" IsVisible="{Binding !VamPathConfigured}" />
          <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" />
        </StackPanel>
      </c:Card>
    </Grid>
  </DockPanel>
</UserControl>
