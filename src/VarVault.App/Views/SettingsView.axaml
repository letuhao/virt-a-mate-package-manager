<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             x:Class="VarVault.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Margin="18" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
    <c:Tabs ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}" />
    <c:Card Header="General" IsVisible="{Binding IsGeneralTab}">
      <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="VaM install path" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,14,4" />
        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBox Grid.Column="0" Name="PART_VamPath" Text="{Binding VamPath}" Watermark="Path to your VaM install folder" />
          <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseVamPathCommand}" />
        </Grid>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VamPathValidationMessage}"
                   Foreground="{DynamicResource CritBrush}" FontSize="12" Margin="0,0,0,10"
                   IsVisible="{Binding VamPathValidationMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Data folder" VerticalAlignment="Top" Opacity="0.8" Margin="0,6,14,10" />
        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" Margin="0,0,0,10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Name="PART_DataDir" Text="{Binding DataDirectory}" IsReadOnly="True"
                     IsEnabled="{Binding !DataDirEnvOverride}" />
            <Button Grid.Column="1" Content="Change folder…" Margin="6,0,0,0"
                    Command="{Binding ChangeDataFolderCommand}" IsEnabled="{Binding !DataDirEnvOverride}" />
            <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0"
                    Command="{Binding ResetDataFolderCommand}" IsEnabled="{Binding !DataDirEnvOverride}" />
          </Grid>
          <TextBlock Text="{Binding CatalogDbFile, StringFormat='Catalog DB: {0}'}" Opacity="0.6" FontSize="11"
                     FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ThumbnailsDbFile, StringFormat='Preview cache (sharded): {0}'}" Opacity="0.6" FontSize="11"
                     FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Changing the folder takes effect after a restart; your existing catalog isn't moved automatically."
                     Opacity="0.55" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !DataDirEnvOverride}" />
          <TextBlock Text="Data folder is fixed by the VARVAULT_DATA_DIR environment variable." Foreground="{DynamicResource WarnBrush}"
                     FontSize="11" TextWrapping="Wrap" IsVisible="{Binding DataDirEnvOverride}" />
        </StackPanel>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fix-on-import" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,14,0" />
        <ComboBox Grid.Row="3" Grid.Column="1" Name="PART_FixOnImport" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding FixOnImportOptions}" SelectedItem="{Binding FixOnImport}" />
      </Grid>
    </c:Card>

    <c:Card Header="Tiers &amp; policy" IsVisible="{Binding IsTiersTab}">
      <StackPanel Spacing="10">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0" Text="Hot threshold (days)" VerticalAlignment="Center" Opacity="0.8" />
            <TextBox Grid.Column="1" Text="{Binding HotThresholdDays}" />
          </Grid>
          <TextBlock Text="Days of recent use for hot scoring (recency horizon + primary usage window)."
                     Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Import usage from VaM log" FontWeight="SemiBold" Opacity="0.9" />
          <TextBox Text="{Binding VamLogText}" AcceptsReturn="True" MinHeight="72" MaxHeight="140"
                   FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                   Watermark="Paste output_log.txt (or Browse…)…" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Browse…" Command="{Binding BrowseVamLogCommand}" />
            <Button Content="Preview" Command="{Binding PreviewVamLogUsageCommand}" />
            <Button Content="Import usage" Command="{Binding ImportVamLogUsageCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="White" />
          </StackPanel>
          <TextBlock Text="{Binding VamLogStatus}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding VamLogStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </StackPanel>
    </c:Card>
    <c:Card Header="Automation" IsVisible="{Binding IsAutomationTab}">
      <StackPanel Spacing="6">
        <CheckBox Content="Auto-rebalance tiers on idle" IsChecked="{Binding AutoRebalance}" />
        <TextBlock Text="When idle, migrate misplaced packages toward their scored tier (capacity-gated)."
                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </c:Card>
    <c:Card Header="Import" IsVisible="{Binding IsImportTab}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="200,*">
          <TextBlock Grid.Column="0" Text="Archive temp folder" VerticalAlignment="Center" Opacity="0.8" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding ImportTempDir}" Watermark="default: target repo's drive…" />
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseImportTempCommand}" />
          </Grid>
        </Grid>
        <Grid ColumnDefinitions="200,*">
          <TextBlock Grid.Column="0" Text="7-Zip path (optional)" VerticalAlignment="Top" Opacity="0.8" Margin="0,6,0,0" />
          <StackPanel Grid.Column="1" Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding SevenZipPath}" Watermark="auto-detect system 7-Zip (7z.exe)…" />
              <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseSevenZipCommand}" />
            </Grid>
            <TextBlock Text="Fallback for archives the built-in extractor can't read (e.g. AES-encrypted 7z). Left blank, VarVault auto-detects an installed 7-Zip."
                       Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="200,*">
          <TextBlock Grid.Column="0" Text="Import history to keep" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Grid.Column="1" Text="{Binding ImportHistoryKeep}" Watermark="200" />
        </Grid>
      </StackPanel>
    </c:Card>
    <c:Card Header="Advanced" IsVisible="{Binding IsAdvancedTab}">
      <TextBlock Text="Catalog is WAL-journaled and auto-backed-up. Rebuild the index from the library rail."
                 Opacity="0.7" TextWrapping="Wrap" />
    </c:Card>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="Save" Command="{Binding SaveCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
