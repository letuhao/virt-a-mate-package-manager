<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             x:Class="VarVault.App.Views.AliasDialog"
             x:DataType="vm:AliasViewModel">
  <StackPanel Spacing="10" MinWidth="420">
    <TextBlock Text="Resolve missing dependency" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
    <TextBlock Text="{Binding MissingRef, StringFormat='Missing: {0}'}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource CritBrush}" />
    <TextBlock Text="Map to an owned package" Opacity="0.8" />
    <TextBox Watermark="search your library…" />
    <TextBlock Text="Save scope" Opacity="0.8" />
    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding Scope}" />
    <TextBlock Text="Saved aliases re-apply automatically on every load &amp; preset switch." Opacity="0.7" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Save alias" Command="{Binding SaveCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" VerticalAlignment="Center" Foreground="{DynamicResource GoodBrush}" />
    </StackPanel>
  </StackPanel>
</UserControl>
