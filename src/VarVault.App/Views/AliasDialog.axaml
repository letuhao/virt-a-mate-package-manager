<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.AliasDialog"
             x:DataType="vm:AliasViewModel">
  <!-- ListBox + TextBox (not AutoCompleteBox): selecting an owned package must not clear the ItemsSource mid-bind. -->
  <StackPanel Spacing="10" MinWidth="480">
    <TextBlock Text="Resolve missing dependency" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
    <Grid ColumnDefinitions="*,Auto">
      <SelectableTextBlock Grid.Column="0" Text="{Binding MissingRef}" FontFamily="{DynamicResource MonoFont}"
                           Foreground="{DynamicResource CritBrush}" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Copy" Command="{Binding CopyMissingCommand}" Margin="8,0,0,0"
              VerticalAlignment="Top" ToolTip.Tip="Copy missing package name" />
    </Grid>
    <TextBlock Text="Map to an owned package (dummy / substitute is fine)" Opacity="0.8" />
    <TextBox Watermark="search your library…"
             Text="{Binding OwnedQuery, UpdateSourceTrigger=PropertyChanged}" />
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="220" MinHeight="120">
      <ListBox ItemsSource="{Binding OwnedMatches}"
               SelectedItem="{Binding SelectedOwned}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="lib:PackageListEntry">
            <SelectableTextBlock Text="{Binding VarName}" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanSave}">
      <TextBlock Grid.Column="0" Text="{Binding SelectedOwned.VarName, StringFormat='→ {0}'}" Opacity="0.7"
                 Foreground="{DynamicResource GoodBrush}" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Copy" Command="{Binding CopyOwnedCommand}" Margin="8,0,0,0" />
    </Grid>
    <TextBlock Text="Saved aliases apply globally, re-resolve immediately, and create a ___MissingVarLink___ symlink on the active profile (like the old Missing Vars OK)."
               Opacity="0.7" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Save alias" Command="{Binding SaveCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" VerticalAlignment="Center" Foreground="{DynamicResource GoodBrush}" />
      <TextBlock Text="{Binding ClipboardStatus}" Opacity="0.65" VerticalAlignment="Center" FontSize="11"
                 IsVisible="{Binding ClipboardStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
