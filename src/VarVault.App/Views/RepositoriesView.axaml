<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:repo="clr-namespace:VarVault.Sdk.Repositories;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.RepositoriesView"
             x:DataType="vm:RepositoriesViewModel">
  <ScrollViewer Padding="18">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Repositories &amp; tiers" FontSize="21" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="↻ Re-index all" Margin="0,0,8,0" Command="{Binding ReindexAllReposCommand}" />
        <Button Grid.Column="2" Content="Review rebalance plan" Margin="0,0,8,0" Command="{Binding RebalanceCommand}" />
        <Button Grid.Column="3" Content="+ Add repository" Command="{Binding AddRepoCommand}"
                Background="{DynamicResource AccentBrush}" Foreground="White" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Repositories}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RepositoryCardViewModel">
            <c:Card Width="320" Margin="0,0,14,14">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="{Binding Tier, StringFormat='T{0}'}" Foreground="White" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
                  <c:Tag Content="online" Kind="Good" IsVisible="{Binding IsOnline}" />
                  <c:Tag Content="offline" IsVisible="{Binding !IsOnline}" />
                </StackPanel>
                <TextBlock Text="{Binding MediaType}" Opacity="0.7" FontSize="11" />
                <TextBlock Text="{Binding MountPath}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                <!-- usage bar + capacity line -->
                <c:MeterBar Height="5" Margin="0,4,0,0" Value="{Binding UsedFraction}" Fill="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding CapacityLabel}" Opacity="0.6" FontSize="11" FontFamily="{DynamicResource MonoFont}" />
                <!-- per-card actions -->
                <WrapPanel Margin="0,6,0,0" IsVisible="{Binding !IsConfirmingRemove}">
                  <Button Content="↻ Re-index" Margin="0,0,6,6"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).ReindexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Re-benchmark" Margin="0,0,6,6"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).BenchmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Tier ▾" Margin="0,0,6,6">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="T1 (hot)" Command="{Binding ((vm:RepositoriesViewModel)DataContext).SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TierArg1}" />
                        <MenuItem Header="T2 (warm)" Command="{Binding ((vm:RepositoriesViewModel)DataContext).SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TierArg2}" />
                        <MenuItem Header="T3 (cold)" Command="{Binding ((vm:RepositoriesViewModel)DataContext).SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TierArg3}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                  <Button Content="Edit" Margin="0,0,6,6"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Rebalance…" Margin="0,0,6,6"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).RebalanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Remove" Margin="0,0,6,6" Foreground="{DynamicResource CritBrush}"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).AskRemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </WrapPanel>

                <!-- inline remove confirm: DB-only, never deletes files -->
                <Border IsVisible="{Binding IsConfirmingRemove}" Margin="0,6,0,0"
                        Background="{DynamicResource CritBgBrush}" BorderBrush="{DynamicResource CritBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                  <StackPanel Spacing="7">
                    <TextBlock Text="Remove this repository from VarVault's catalog?" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHiBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="This only de-registers it — your folder and every .var file stay exactly where they are on disk. You can add it again later."
                               Opacity="0.75" FontSize="11.5" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Remove from catalog" Background="{DynamicResource CritBrush}" Foreground="White"
                              Command="{Binding ((vm:RepositoriesViewModel)DataContext).RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Content="Cancel"
                              Command="{Binding ((vm:RepositoriesViewModel)DataContext).CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </c:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="No repositories yet." Opacity="0.7" IsVisible="{Binding IsEmpty}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
