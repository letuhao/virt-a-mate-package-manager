<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:repo="clr-namespace:VarVault.Sdk.Repositories;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.RepositoriesView"
             x:DataType="vm:RepositoriesViewModel">
  <ScrollViewer Padding="18">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Repositories &amp; tiers" FontSize="21" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Review rebalance plan" Margin="0,0,8,0" Command="{Binding RebalanceCommand}" />
        <Button Grid.Column="2" Content="+ Add repository" Command="{Binding AddRepoCommand}"
                Background="{DynamicResource AccentBrush}" Foreground="White" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Repositories}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RepositoryCardViewModel">
            <c:Card Width="320" Margin="0,0,14,14">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="{Binding Tier, StringFormat='T{0}'}" Foreground="White" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
                  <c:Tag Content="online" Kind="Good" IsVisible="{Binding IsOnline}" />
                  <c:Tag Content="offline" IsVisible="{Binding !IsOnline}" />
                </StackPanel>
                <TextBlock Text="{Binding MediaType}" Opacity="0.7" FontSize="11" />
                <TextBlock Text="{Binding MountPath}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                <!-- usage bar + capacity line -->
                <c:MeterBar Height="5" Margin="0,4,0,0" Value="{Binding UsedFraction}" Fill="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding CapacityLabel}" Opacity="0.6" FontSize="11" FontFamily="{DynamicResource MonoFont}" />
                <!-- per-card actions -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                  <Button Content="Re-benchmark"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).BenchmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Tier ▾">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="T1 (hot)" Command="{Binding ((vm:RepositoriesViewModel)DataContext).SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TierArg1}" />
                        <MenuItem Header="T2 (warm)" Command="{Binding ((vm:RepositoriesViewModel)DataContext).SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TierArg2}" />
                        <MenuItem Header="T3 (cold)" Command="{Binding ((vm:RepositoriesViewModel)DataContext).SetTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TierArg3}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                  <Button Content="Edit"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Rebalance…"
                          Command="{Binding ((vm:RepositoriesViewModel)DataContext).RebalanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
              </StackPanel>
            </c:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="No repositories yet." Opacity="0.7" IsVisible="{Binding IsEmpty}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
