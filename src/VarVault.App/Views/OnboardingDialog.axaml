<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             x:Class="VarVault.App.Views.OnboardingDialog"
             x:DataType="vm:OnboardingViewModel">
  <StackPanel Spacing="12" MinWidth="440">
    <TextBlock Text="Welcome — set up your library" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
    <!-- Visual stepper (doc 26 · F-9) -->
    <StackPanel Orientation="Horizontal" Spacing="6">
      <StackPanel.Styles>
        <Style Selector="Border.step"><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10,3" /><Setter Property="Background" Value="#22808080" /></Style>
        <Style Selector="Border.step.on"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
        <Style Selector="Border.step > TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Opacity" Value="0.7" /></Style>
        <Style Selector="Border.step.on > TextBlock"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="White" /></Style>
      </StackPanel.Styles>
      <Border Classes="step" Classes.on="{Binding IsAtAddDrives}"><TextBlock Text="1 Add drives" /></Border>
      <Border Classes="step" Classes.on="{Binding IsAtBenchmark}"><TextBlock Text="2 Benchmark" /></Border>
      <Border Classes="step" Classes.on="{Binding IsAtIndex}"><TextBlock Text="3 Index" /></Border>
      <Border Classes="step" Classes.on="{Binding IsAtRescue}"><TextBlock Text="4 Rescue" /></Border>
      <Border Classes="step" Classes.on="{Binding IsAtDone}"><TextBlock Text="5 Done" /></Border>
    </StackPanel>
    <TextBlock Text="Point VarVault at a folder where your .var files live." Opacity="0.8" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Width="240" Watermark="D:\vars" Text="{Binding FolderPath}" />
      <Button Content="Browse…" Command="{Binding BrowseCommand}" />
      <Button Content="Add &amp; index" Command="{Binding AddAndIndexCommand}"
              Background="{DynamicResource AccentBrush}" Foreground="White" />
    </StackPanel>
    <TextBlock Text="{Binding ResultMessage}" Opacity="0.8" Foreground="{DynamicResource GoodBrush}" />
    <!-- Benchmarked-folder table (AC-29) -->
    <ItemsControl ItemsSource="{Binding BenchmarkedFolders}">
      <ItemsControl.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding}" FontSize="12" Opacity="0.85" Margin="0,1" /></DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Back" Command="{Binding BackCommand}" />
      <Button Content="Continue →" Command="{Binding NextCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
