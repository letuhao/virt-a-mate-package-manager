<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:imp="clr-namespace:VarVault.Sdk.Import;assembly=VarVault.Sdk"
             xmlns:repo="clr-namespace:VarVault.Sdk.Repositories;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <Panel>
    <DockPanel Margin="18">
      <!-- Head + target + actions -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Text="Import &amp; review" FontSize="21" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock Text="Import into" Opacity="0.6" VerticalAlignment="Center" FontSize="12" />
          <ComboBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding TargetRepo}" MinWidth="180"
                    IsEnabled="{Binding CanEditSources}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="repo:RepositoryInfo">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <c:Tag Content="{Binding Tier, StringFormat='T{0}'}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Button Grid.Column="2" Content="⚡ Quick import (profile)" Command="{Binding QuickImportCommand}" Margin="0,0,6,0"
                IsEnabled="{Binding CanQuickImport}"
                ToolTip.Tip="Scan loose .var files in the active VaM profile (in-game downloads). Skips ___VarsLink___ / alias symlinks." />
        <Button Grid.Column="3" Content="📁 + Folder…" Command="{Binding AddFolderCommand}" Margin="0,0,6,0"
                IsEnabled="{Binding CanEditSources}" />
        <Button Grid.Column="4" Content="🗜 + Archive…" Command="{Binding AddArchiveCommand}" Margin="0,0,6,0"
                IsEnabled="{Binding CanEditSources}" />
        <Button Grid.Column="5" Content="🕘 History" Command="{Binding OpenHistoryCommand}" Margin="0,0,6,0" />
        <Button Grid.Column="6" Content="Scan" Command="{Binding ScanCommand}"
                Background="{DynamicResource AccentBrush}" Foreground="White"
                ToolTip.Tip="{Binding GateHint}" />
      </Grid>
      <TextBlock DockPanel.Dock="Top" Text="{Binding QuickImportHint}" Opacity="0.7" FontSize="11.5"
                 TextWrapping="Wrap" Margin="0,0,0,8"
                 IsVisible="{Binding QuickImportHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Sources strip: pending picks (before Scan) + scanned ImportSource chips (after Scan) -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                  IsVisible="{Binding HasPendingSources}">
        <ItemsControl ItemsSource="{Binding SourcePaths}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="14" Padding="10,4" Margin="0,0,8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
                  <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="220" />
                  <Button Content="✕" FontSize="10" Padding="4,0"
                          Command="{Binding $parent[UserControl].((vm:ImportViewModel)DataContext).RemoveSourceCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="Remove source" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                  IsVisible="{Binding HasScannedSources}">
        <ItemsControl ItemsSource="{Binding Sources}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="imp:ImportSource">
              <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="14" Padding="10,4" Margin="0,0,8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Kind}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextHiBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="200" />
                  <c:Tag Content="{Binding VarCount, StringFormat='{}{0} var'}" IsVisible="{Binding VarCount}" />
                  <c:Tag Content="{Binding FailReason}" Kind="Crit"
                         IsVisible="{Binding FailReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
        <TextBlock Text="{Binding SourcesSummary}" Opacity="0.6" FontSize="11.5" VerticalAlignment="Center" />
        <TextBlock Text="{Binding GateHint}" Opacity="0.75" FontSize="11.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource WarnBrush}" />
        <TextBlock Text="{Binding StatusMessage}" Opacity="0.6" FontSize="11.5" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Background Scan/Apply progress (Jobs panel also shows the same job) -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding IsOperationRunning}" Margin="0,0,0,8"
              Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="10,8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding OperationProgress}" Height="6" />
            <TextBlock Text="{Binding OperationMessage}" FontSize="11.5" Opacity="0.75" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Running in background…" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelOperationCommand}"
                  IsEnabled="{Binding CanCancelOperation}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- D1 dedup-trust warnings (offline / unindexed target repo) -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding HasWarnings}" Margin="0,0,0,8"
              Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBrush}"
              BorderThickness="1" CornerRadius="6" Padding="10,7">
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="⚠" Foreground="{DynamicResource WarnBrush}" FontSize="12" VerticalAlignment="Top" />
                <TextBlock Text="{Binding}" Foreground="{DynamicResource WarnBrush}" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Stepper: Sources → Scan → Review → Apply -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" IsVisible="{Binding HasSession}">
        <c:Tag Content="① Sources" />
        <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
        <c:Tag Content="② Scan &amp; extract" />
        <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
        <c:Tag Content="③ Review" Kind="Warn" />
        <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
        <c:Tag Content="④ Apply → repo" />
      </StackPanel>

      <!-- Triage chips + worknote -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding HasSession}">
        <WrapPanel Grid.Column="0">
          <Button Command="{Binding FilterCommand}" CommandParameter="all" Margin="0,0,8,0"><TextBlock Text="{Binding TotalScanned, StringFormat='All {0}'}" /></Button>
          <Button Command="{Binding FilterCommand}" CommandParameter="New" Margin="0,0,8,0"><TextBlock Text="{Binding NewCount, StringFormat='New {0}'}" Foreground="{DynamicResource GoodBrush}" /></Button>
          <Button Command="{Binding FilterCommand}" CommandParameter="Cjk" Margin="0,0,8,0"><TextBlock Text="{Binding CjkCount, StringFormat='CJK {0}'}" Foreground="{DynamicResource ColdBrush}" /></Button>
          <Button Command="{Binding FilterCommand}" CommandParameter="Exact" Margin="0,0,8,0"><TextBlock Text="{Binding ExactCount, StringFormat='Exact {0}'}" Opacity="0.7" /></Button>
          <Button Command="{Binding FilterCommand}" CommandParameter="Naming" Margin="0,0,8,0"><TextBlock Text="{Binding NamingCount, StringFormat='Name≠meta {0}'}" Foreground="{DynamicResource WarnBrush}" /></Button>
          <Button Command="{Binding FilterCommand}" CommandParameter="Conflict" Margin="0,0,8,0"><TextBlock Text="{Binding ConflictCount, StringFormat='Conflict {0}'}" Foreground="{DynamicResource WarnBrush}" /></Button>
          <Button Command="{Binding FilterCommand}" CommandParameter="Corrupt" Margin="0,0,8,0"><TextBlock Text="{Binding CorruptCount, StringFormat='Corrupt {0}'}" Foreground="{DynamicResource CritBrush}" /></Button>
        </WrapPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Opacity="0.7" TextAlignment="Right"
                   Text="{Binding ReviewRemaining, StringFormat='Only {0} item(s) need your decision'}" />
      </Grid>

      <!-- Action bar (bottom) — high Z so work-area overflow never steals clicks. -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0" ZIndex="10">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                       Text="{Binding ReviewResolved, StringFormat='{}{0} /'}" />
            <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                       Text="{Binding ReviewTotal, StringFormat='{}{0} reviewed'}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReviewProgress}" Width="120" Height="6"
                         VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Opacity="0.75"
                     Text="{Binding ApplyPlanSummary}" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" Spacing="12" IsEnabled="{Binding CanEditReview}">
              <Button Content="✨ Accept all recommendations" Command="{Binding AcceptAllCommand}"
                      ToolTip.Tip="Fill every undecided review item with the recommender’s choice (keeps decisions you already made)." />
              <Button Content="↷ Skip remaining" Command="{Binding SkipRemainingCommand}"
                      IsVisible="{Binding HasUndecidedReview}"
                      ToolTip.Tip="Leave your current choices; mark everything else as skip / keep repo. Then Apply." />
              <CheckBox Content="Activate into VaM after import" IsChecked="{Binding ActivateAfter}" VerticalAlignment="Center"
                        IsEnabled="{Binding CanEditSources}" />
            </StackPanel>
            <CheckBox Content="Trash originals after Apply" IsChecked="{Binding TrashOriginalsAfterApply}" VerticalAlignment="Center"
                      ToolTip.Tip="After a successful copy, move the loose profile .var originals into VarVault Trash (not symlinks). Default on for Quick import." />
            <Button Content="🗑 Trash originals" Command="{Binding TrashOriginalsCommand}"
                    IsEnabled="{Binding CanTrashOriginals}"
                    ToolTip.Tip="Move successfully imported loose .var files from the profile into Trash (restorable). Skips symlinks." />
          </StackPanel>
          <Button Grid.Column="4" Content="Apply →" Command="{Binding ApplyCommand}"
                  Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
        </Grid>
      </Border>

      <!-- Work area: list | resolver — ClipToBounds so overflow cannot steal clicks from the action bar. -->
      <Grid ColumnDefinitions="*,1.1*" ClipToBounds="True">
        <DockPanel Grid.Column="0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Filter by name / creator…"
                     FontSize="12" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding Pager.TotalCount, StringFormat='{}{0} items'}" Opacity="0.6" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="▤ / ▦" Command="{Binding ToggleViewCommand}" />
          </Grid>
          <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                           PageNumber="{Binding Pager.PageNumber}"
                           PageCount="{Binding Pager.PageCount}"
                           PageSize="{Binding Pager.PageSize}"
                           TotalCount="{Binding Pager.TotalCount}"
                           SummaryLabel="{Binding Pager.SummaryLabel}"
                           PreviousCommand="{Binding PreviousPageCommand}"
                           NextCommand="{Binding NextPageCommand}"
                           GoToPageCommand="{Binding GoToPageCommand}"
                           PageSizeChangedCommand="{Binding ChangePageSizeCommand}" />
          <!-- Table -->
          <ListBox IsVisible="{Binding !GalleryView}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ImportItemViewModel">
                <Grid ColumnDefinitions="4,*,Auto" Height="34">
                  <Border Grid.Column="0" Width="3" CornerRadius="2" VerticalAlignment="Stretch" Margin="0,4"
                          Background="{Binding Lane, Converter={StaticResource LaneToBrush}}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding FileName}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource TextHiBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Creator}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                      <TextBlock Text="{Binding SizeLabel}" FontSize="11" Opacity="0.6" />
                      <TextBlock Text="{Binding GbkCount, StringFormat='{}{0} GBK'}" FontSize="10" Foreground="{DynamicResource ColdBrush}" IsVisible="{Binding IsCjk}" />
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="8,2"
                          Background="{DynamicResource Bg3Brush}">
                    <TextBlock Text="{Binding ListPillText}" FontSize="10.5"
                               Foreground="{Binding Lane, Converter={StaticResource LaneToBrush}}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Gallery -->
          <ListBox IsVisible="{Binding GalleryView}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                   Background="Transparent">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ImportItemViewModel">
                <Border Width="150" Margin="6" Background="{DynamicResource Bg1Brush}"
                        BorderBrush="{Binding Lane, Converter={StaticResource LaneToBrush}}"
                        BorderThickness="0,3,0,0" CornerRadius="8">
                  <StackPanel>
                    <Panel Height="90">
                      <Border Background="{DynamicResource Bg3Brush}" />
                      <Image Source="{Binding PreviewPath, Converter={StaticResource PathToBitmap}}"
                             Stretch="UniformToFill" IsVisible="{Binding HasPreview}"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" CornerRadius="9" Padding="7,1"
                              Background="{DynamicResource Bg0Brush}">
                        <TextBlock Text="{Binding ListPillText}" FontSize="10"
                                   Foreground="{Binding Lane, Converter={StaticResource LaneToBrush}}" />
                      </Border>
                    </Panel>
                    <StackPanel Margin="8,6">
                      <TextBlock Text="{Binding FileName}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextHiBrush}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Creator}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="10" Opacity="0.6" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Resolver: decisions stay docked; long diffs scroll inside a bounded viewport. -->
        <c:Card Grid.Column="1" Margin="14,0,0,0" Header="Details" VerticalAlignment="Stretch"
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <DockPanel DataContext="{Binding Selected}" x:DataType="vm:ImportItemViewModel">
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0"
                        IsEnabled="{Binding $parent[UserControl].((vm:ImportViewModel)DataContext).CanEditReview}">
              <TextBlock Text="Decision:" Opacity="0.6" FontSize="12" />
              <WrapPanel IsVisible="{Binding IsNew}">
                <Button Content="✅ Import" Command="{Binding ChooseCommand}" CommandParameter="Import" Margin="0,0,6,6" />
                <Button Content="⤫ Skip" Command="{Binding ChooseCommand}" CommandParameter="Skip" Margin="0,0,6,6" />
              </WrapPanel>
              <WrapPanel IsVisible="{Binding IsExact}">
                <Button Content="⤫ Skip (already have)" Command="{Binding ChooseCommand}" CommandParameter="Skip" Margin="0,0,6,6" />
                <Button Content="✅ Import a copy" Command="{Binding ChooseCommand}" CommandParameter="Import" Margin="0,0,6,6" />
              </WrapPanel>
              <WrapPanel IsVisible="{Binding IsCjk}">
                <Button Content="🈶 Import + fix Unicode" Command="{Binding ChooseCommand}" CommandParameter="ImportAndFix" Margin="0,0,6,6" />
                <Button Content="✅ Import (no fix)" Command="{Binding ChooseCommand}" CommandParameter="Import" Margin="0,0,6,6" />
                <Button Content="⤫ Skip" Command="{Binding ChooseCommand}" CommandParameter="Skip" Margin="0,0,6,6" />
              </WrapPanel>
              <WrapPanel IsVisible="{Binding IsNaming}">
                <Button Content="🏷 Rename to meta" Command="{Binding ChooseCommand}" CommandParameter="RenameToMeta" Margin="0,0,6,6" />
                <Button Content="✅ Keep filename" Command="{Binding ChooseCommand}" CommandParameter="Import" Margin="0,0,6,6" />
                <Button Content="🗑 Discard" Command="{Binding ChooseCommand}" CommandParameter="Discard" Margin="0,0,6,6" />
              </WrapPanel>
              <WrapPanel IsVisible="{Binding IsConflict}">
                <Button Content="✅ Keep new" Command="{Binding ChooseCommand}" CommandParameter="KeepIncoming" Margin="0,0,6,6" />
                <Button Content="↩︎ Keep existing" Command="{Binding ChooseCommand}" CommandParameter="KeepExisting" Margin="0,0,6,6" />
                <Button Content="🔀 Keep both" Command="{Binding ChooseCommand}" CommandParameter="KeepBoth" Margin="0,0,6,6" />
                <Button Content="🗑 Discard" Command="{Binding ChooseCommand}" CommandParameter="Discard" Margin="0,0,6,6" />
              </WrapPanel>
              <WrapPanel IsVisible="{Binding IsCorrupt}">
                <Button Content="🗑 Discard (recommended)" Command="{Binding ChooseCommand}" CommandParameter="Discard" Margin="0,0,6,6" />
                <Button Content="⚠ Import anyway" Command="{Binding ChooseCommand}" CommandParameter="Import" Margin="0,0,6,6" />
              </WrapPanel>
              <TextBlock Text="{Binding DecisionLabel, StringFormat='Selected: {0}'}" Foreground="{DynamicResource GoodBrush}"
                         FontSize="12" IsVisible="{Binding IsResolved}" />
              <TextBlock Text="J/K move · ] choice 1 · [ choice 2 · \ both · Del discard" Opacity="0.5" FontSize="11"
                         IsVisible="{Binding NeedsReview}" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding FileName}" FontFamily="{DynamicResource MonoFont}" FontSize="14"
                           Foreground="{DynamicResource TextHiBrush}" TextWrapping="Wrap" />
                <Border CornerRadius="6" ClipToBounds="True" MaxHeight="180" HorizontalAlignment="Left"
                        IsVisible="{Binding HasPreview}">
                  <Image Source="{Binding PreviewPath, Converter={StaticResource PathToBitmap}}" Stretch="Uniform" />
                </Border>
                <Border Background="{DynamicResource Bg2Brush}" CornerRadius="6" Padding="10">
                  <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <Grid ColumnDefinitions="120,*,*" RowDefinitions="Auto,Auto" IsVisible="{Binding IsNaming}">
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="By filename" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="By meta.json" Foreground="{DynamicResource ColdBrush}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Identity" Opacity="0.6" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FilenameIdentity}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MetaIdentityLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>

                <Grid ColumnDefinitions="120,*,*" IsVisible="{Binding HasExisting}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="Incoming" Foreground="{DynamicResource GoodBrush}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="In repo" Foreground="{DynamicResource ColdBrush}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Valid zip" Opacity="0.6" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IntegrityStatus}" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Existing.Signals.IntegrityStatus}" FontSize="12" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Opacity="0.6" FontSize="12" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeLabel}" FontSize="12" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Existing.Signals.SizeBytes, Converter={StaticResource BytesToSize}}" FontSize="12" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Entries" Opacity="0.6" FontSize="12" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EntryCount}" FontSize="12" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Existing.Signals.EntryCount}" FontSize="12" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Repo" Opacity="0.6" FontSize="12" />
                  <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Existing.RepositoryName}" FontSize="12" />
                </Grid>

                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding HasDiff}">
                  <ItemsControl ItemsSource="{Binding Diff}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="imp:EntryDelta">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Kind}" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="Bold" Width="12" />
                          <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </c:Card>
      </Grid>
    </DockPanel>

    <!-- History overlay: run list + detail report (failed items / failed sources).
         IsHitTestVisible must follow HistoryOpen — a full-Panel sibling that stays
         hit-testable while IsVisible=False will eat clicks on + Folder / + Archive. -->
    <Border IsVisible="{Binding HistoryOpen}"
            IsHitTestVisible="{Binding HistoryOpen}"
            Background="#88000000">
      <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Width="920" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center">
        <DockPanel Margin="18">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="🕘 Import history" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
            <Button Grid.Column="1" Content="✕" Command="{Binding CloseHistoryCommand}" />
          </Grid>
          <Grid ColumnDefinitions="280,*" RowDefinitions="*">
            <!-- Run list -->
            <ScrollViewer Grid.Column="0" Margin="0,0,12,0">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="imp:ImportRun">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"
                            Background="Transparent" Cursor="Hand">
                      <Border.Styles>
                        <Style Selector="Border:pointerover">
                          <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
                        </Style>
                      </Border.Styles>
                      <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left" Padding="6,4"
                              Command="{Binding $parent[UserControl].((vm:ImportViewModel)DataContext).OpenHistoryDetailCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding StartedUtc}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                                     Foreground="{DynamicResource TextHiBrush}" />
                          <TextBlock Text="{Binding SourceSummary}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Copied, StringFormat='✓ {0}'}" FontSize="11" Foreground="{DynamicResource GoodBrush}" />
                            <TextBlock Text="{Binding Skipped, StringFormat='↷ {0}'}" FontSize="11" Opacity="0.6" />
                            <TextBlock Text="{Binding Failed, StringFormat='✗ {0}'}" FontSize="11" Foreground="{DynamicResource CritBrush}" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Detail report -->
            <Border Grid.Column="1" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14"
                    IsVisible="{Binding HasHistoryDetail}">
              <DockPanel>
                <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,10,0,0"
                                 PageNumber="{Binding HistoryOutcomesPager.PageNumber}"
                                 PageCount="{Binding HistoryOutcomesPager.PageCount}"
                                 PageSize="{Binding HistoryOutcomesPager.PageSize}"
                                 TotalCount="{Binding HistoryOutcomesPager.TotalCount}"
                                 SummaryLabel="{Binding HistoryOutcomesPager.SummaryLabel}"
                                 PreviousCommand="{Binding HistoryPreviousPageCommand}"
                                 NextCommand="{Binding HistoryNextPageCommand}"
                                 GoToPageCommand="{Binding HistoryGoToPageCommand}"
                                 PageSizeChangedCommand="{Binding HistoryChangePageSizeCommand}" />
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                  <TextBlock Text="{Binding SelectedHistoryTitle}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextHiBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedHistoryCounts}" FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding HistoryOutcomeSearch}"
                             Watermark="Search filename, identity, or reason…" FontSize="11.5" Margin="0,0,8,0" />
                    <WrapPanel Grid.Column="1">
                      <Button Content="All" Command="{Binding FilterHistoryOutcomesCommand}" CommandParameter="all" Margin="0,0,4,0" />
                      <Button Content="Failed" Command="{Binding FilterHistoryOutcomesCommand}" CommandParameter="failed" Margin="0,0,4,0" />
                      <Button Content="Copied" Command="{Binding FilterHistoryOutcomesCommand}" CommandParameter="copied" Margin="0,0,4,0" />
                      <Button Content="Skipped" Command="{Binding FilterHistoryOutcomesCommand}" CommandParameter="skipped" Margin="0,0,4,0" />
                      <Button Content="Discarded" Command="{Binding FilterHistoryOutcomesCommand}" CommandParameter="discarded" />
                    </WrapPanel>
                  </Grid>

                  <!-- Archive/folder extraction errors are not per-item outcomes. -->
                  <StackPanel IsVisible="{Binding SelectedHasFailedSources}" Spacing="5">
                    <TextBlock Text="Failed sources" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource CritBrush}" />
                    <ItemsControl ItemsSource="{Binding SelectedHistoryRun.FailedSources}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="imp:ImportFailedSource">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource CritBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center">
                              <Run Text="🔒 " /><Run Text="{Binding Path}" /><Run Text=" — " /><Run Text="{Binding Reason}" />
                            </TextBlock>
                            <Button Grid.Column="1" Content="Retry…" FontSize="11" Padding="8,2"
                                    Command="{Binding $parent[UserControl].((vm:ImportViewModel)DataContext).RetryFailedSourceCommand}"
                                    CommandParameter="{Binding Path}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>

                <!-- Full, paged, reviewable per-file ledger. -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,1.4*,80,100,80,1.5*" Height="28"
                          Background="{DynamicResource Bg2Brush}">
                      <TextBlock Grid.Column="0" Text="File" FontWeight="SemiBold" FontSize="10.5" Margin="7,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="Identity" FontWeight="SemiBold" FontSize="10.5" Margin="7,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="Lane" FontWeight="SemiBold" FontSize="10.5" Margin="7,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="Decision" FontWeight="SemiBold" FontSize="10.5" Margin="7,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" FontSize="10.5" Margin="7,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="Reason / trace" FontWeight="SemiBold" FontSize="10.5" Margin="7,0" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding HistoryOutcomesPager.Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ImportOutcomeRow">
                            <Grid ColumnDefinitions="2*,1.4*,80,100,80,1.5*" MinHeight="30">
                              <TextBlock Grid.Column="0" Text="{Binding FileName}" FontFamily="{DynamicResource MonoFont}"
                                         FontSize="10.5" Margin="7,4" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding IdentityKey}" FontFamily="{DynamicResource MonoFont}"
                                         FontSize="10.5" Margin="7,4" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding Lane}" FontSize="10.5" Margin="7,4" />
                              <TextBlock Grid.Column="3" Text="{Binding Decision}" FontSize="10.5" Margin="7,4" />
                              <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="10.5" Margin="7,4"
                                         Foreground="{DynamicResource TextHiBrush}" />
                              <TextBlock Grid.Column="5" Text="{Binding Reason}" FontSize="10.5" Margin="7,4"
                                         TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
                <TextBlock Text="No outcomes match this filter." Opacity="0.55" HorizontalAlignment="Center"
                           Margin="0,12" IsVisible="{Binding HistoryOutcomesPager.IsEmpty}" />
              </DockPanel>
            </Border>

            <TextBlock Grid.Column="1" Text="Select a run on the left to see its detail report."
                       Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center"
                       IsVisible="{Binding !HasHistoryDetail}" />
          </Grid>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
