<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.VarDetailDialog"
             x:DataType="vm:VarDetailViewModel">
  <StackPanel Spacing="10" MinWidth="460" x:CompileBindings="False">
    <TextBlock Text="{Binding Detail.VarName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
    <c:Tabs ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}" />

    <!-- Tab 0: Overview -->
    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" DataContext="{Binding Detail}"
          IsVisible="{Binding $parent[UserControl].((vm:VarDetailViewModel)DataContext).IsOverviewTab}">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Identity" Opacity="0.7" Margin="0,0,0,4" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IdentityKey}" Margin="0,0,0,4" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="License" Opacity="0.7" Margin="0,0,0,4" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding License}" Margin="0,0,0,4" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Opacity="0.7" Margin="0,0,0,4" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalSize}" Margin="0,0,0,4" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Depended on by" Opacity="0.7" Margin="0,0,0,4" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DependedOnByCount}" Margin="0,0,0,4" />
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Class" Opacity="0.7" />
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StorageClass}" />
    </Grid>

    <!-- Tab 1: Dependency graph (forward closure) -->
    <StackPanel IsVisible="{Binding IsGraphTab}">
      <TextBlock Text="{Binding GraphPager.TotalCount, StringFormat='Forward closure: {0} dependencies'}" Opacity="0.8" Margin="0,0,0,4" />
      <ItemsControl ItemsSource="{Binding GraphPager.Items}">
        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='#{0}'}" FontFamily="{DynamicResource MonoFont}" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:PaginationBar Margin="0,8,0,0"
                       PageNumber="{Binding GraphPager.PageNumber}"
                       PageCount="{Binding GraphPager.PageCount}"
                       PageSize="{Binding GraphPager.PageSize}"
                       TotalCount="{Binding GraphPager.TotalCount}"
                       SummaryLabel="{Binding GraphPager.SummaryLabel}" />
    </StackPanel>

    <!-- Tab 2: Content items -->
    <StackPanel IsVisible="{Binding IsContentTab}">
      <TextBlock Text="{Binding ContentPager.TotalCount, StringFormat='{}{0} content items'}" Opacity="0.8" Margin="0,0,0,4" />
      <ItemsControl ItemsSource="{Binding ContentPager.Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lib:ContentItemDto">
            <Grid ColumnDefinitions="90,*"><TextBlock Grid.Column="0" Text="{Binding Type}" Opacity="0.7" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding EntryPath}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" /></Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:PaginationBar Margin="0,8,0,0"
                       PageNumber="{Binding ContentPager.PageNumber}"
                       PageCount="{Binding ContentPager.PageCount}"
                       PageSize="{Binding ContentPager.PageSize}"
                       TotalCount="{Binding ContentPager.TotalCount}"
                       SummaryLabel="{Binding ContentPager.SummaryLabel}" />
    </StackPanel>

    <!-- Tab 3: Copies & lineage -->
    <StackPanel IsVisible="{Binding IsCopiesTab}">
      <TextBlock Text="{Binding CopiesPager.TotalCount, StringFormat='{}{0} copies'}" Opacity="0.8" Margin="0,0,0,4" />
      <ItemsControl ItemsSource="{Binding CopiesPager.Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lib:CopyDto">
            <Grid ColumnDefinitions="Auto,*,Auto"><c:Tag Grid.Column="0" Content="{Binding Tier, StringFormat='T{0}'}" /><TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><c:StatePill Grid.Column="2" State="Ok" Text="online" IsVisible="{Binding IsOnline}" /></Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:PaginationBar Margin="0,8,0,0"
                       PageNumber="{Binding CopiesPager.PageNumber}"
                       PageCount="{Binding CopiesPager.PageCount}"
                       PageSize="{Binding CopiesPager.PageSize}"
                       TotalCount="{Binding CopiesPager.TotalCount}"
                       SummaryLabel="{Binding CopiesPager.SummaryLabel}" />
    </StackPanel>
  </StackPanel>
</UserControl>
