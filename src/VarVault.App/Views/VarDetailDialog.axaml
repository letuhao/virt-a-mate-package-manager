<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
             xmlns:views="clr-namespace:VarVault.App.Views"
             x:Class="VarVault.App.Views.VarDetailDialog"
             x:DataType="vm:VarDetailViewModel"
             MinWidth="560" MinHeight="420" Width="720" Height="560">
  <DockPanel Margin="4" x:CompileBindings="False">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Detail.VarName}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextHiBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Edit meta…" Command="{Binding EditMetaCommand}"
                Padding="10,4" VerticalAlignment="Center"
                IsVisible="{Binding IsOverviewTab}" />
      </Grid>
      <c:Tabs ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}" />
    </StackPanel>

    <!-- Fixed body with scroll — avoids StackPanel growth that clips large meta/deps. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Panel MinHeight="320">
        <!-- Overview -->
        <StackPanel Spacing="10" IsVisible="{Binding IsOverviewTab}">
          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" DataContext="{Binding Detail}">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Identity" Opacity="0.7" Margin="0,0,0,6" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IdentityKey}" Margin="0,0,0,6" FontFamily="{DynamicResource MonoFont}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="License" Opacity="0.7" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding License}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Opacity="0.7" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalSize}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Depended on by" Opacity="0.7" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DependedOnByCount}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Class" Opacity="0.7" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StorageClass}" />
          </Grid>
        </StackPanel>

        <!-- Dependencies: one section at a time via sub-tabs -->
        <DockPanel IsVisible="{Binding IsDependenciesTab}">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <c:Tabs ItemsSource="{Binding DepsSections}" SelectedIndex="{Binding SelectedDepsSectionIndex}" />
          </StackPanel>
          <DockPanel>
            <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                             PageNumber="{Binding ActiveDepsPageNumber}" PageCount="{Binding ActiveDepsPageCount}"
                             PageSize="{Binding ActiveDepsPageSize}" TotalCount="{Binding ActiveDepsTotalCount}"
                             SummaryLabel="{Binding ActiveDepsSummary}"
                             PreviousCommand="{Binding ActiveDepsPreviousPageCommand}"
                             NextCommand="{Binding ActiveDepsNextPageCommand}"
                             GoToPageCommand="{Binding ActiveDepsGoToPageCommand}"
                             PageSizeChangedCommand="{Binding ActiveDepsChangePageSizeCommand}" />

            <Border BorderBrush="#22808080" BorderThickness="1" CornerRadius="4" Padding="6" MinHeight="280">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Panel>
                  <ItemsControl ItemsSource="{Binding DirectDepsPager.Items}" IsVisible="{Binding IsDirectDepsSection}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="lib:DependencyEdgeDto">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2" MinHeight="28">
                          <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0"
                                  Command="{Binding ((vm:VarDetailViewModel)DataContext).OpenDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding ResolvedPackage.VarName}">
                            <TextBlock Text="{Binding RequestedRefRaw}" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </Button>
                          <c:Tag Grid.Column="1" Content="{Binding State}" Margin="6,0,0,0" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Content="Copy" Padding="6,2" FontSize="11" Margin="6,0,0,0"
                                  Command="{Binding ((vm:VarDetailViewModel)DataContext).CopyRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Grid.Column="3" Content="Alias" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                  IsVisible="{Binding ResolvedPackage, Converter={x:Static ObjectConverters.IsNull}}"
                                  Command="{Binding ((vm:VarDetailViewModel)DataContext).ResolveAliasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl ItemsSource="{Binding ReverseDepsPager.Items}" IsVisible="{Binding IsReverseDepsSection}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="lib:ReverseDependentDto">
                        <TextBlock Text="{Binding VarName}" FontSize="12" Margin="0,3" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl ItemsSource="{Binding SaveDepsPager.Items}" IsVisible="{Binding IsSaveDepsSection}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="lib:DependencyEdgeDto">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                          <TextBlock Text="{Binding RequestedRefRaw}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                     TextTrimming="CharacterEllipsis" />
                          <c:Tag Grid.Column="1" Content="{Binding State}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </DockPanel>

        <Panel IsVisible="{Binding IsContentTab}" MinHeight="360">
          <views:PackageGalleryView DataContext="{Binding PackageGallery}" />
        </Panel>

        <DockPanel IsVisible="{Binding IsCopiesTab}">
          <c:PaginationBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                           PageNumber="{Binding CopiesPager.PageNumber}" PageCount="{Binding CopiesPager.PageCount}"
                           PageSize="{Binding CopiesPager.PageSize}" TotalCount="{Binding CopiesPager.TotalCount}"
                           SummaryLabel="{Binding CopiesPager.SummaryLabel}"
                           PreviousCommand="{Binding CopiesPreviousPageCommand}"
                           NextCommand="{Binding CopiesNextPageCommand}"
                           GoToPageCommand="{Binding CopiesGoToPageCommand}"
                           PageSizeChangedCommand="{Binding CopiesChangePageSizeCommand}" />
          <Border BorderBrush="#22808080" BorderThickness="1" CornerRadius="4" Padding="6" MinHeight="280">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding CopiesPager.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="lib:CopyDto">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                      <c:Tag Grid.Column="0" Content="{Binding Tier, StringFormat='T{0}'}" />
                      <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                 Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <c:Tag Grid.Column="2" Content="fixed" Kind="Good" Margin="0,0,6,0"
                             IsVisible="{Binding FixedFromVarFileId, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <c:StatePill Grid.Column="3" State="Ok" Text="online" IsVisible="{Binding IsOnline}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
