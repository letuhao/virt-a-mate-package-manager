<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VarVault.App.ViewModels"
        xmlns:lib="clr-namespace:VarVault.Sdk.Library;assembly=VarVault.Sdk"
        x:Class="VarVault.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="760"
        Title="{Binding Title}">

  <DockPanel LastChildFill="True">

    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="16,12" Background="{StaticResource AccentBrush}">
      <DockPanel LastChildFill="False">
        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="Table / Gallery" Command="{Binding Library.ToggleViewModeCommand}" />
      </DockPanel>
    </Border>

    <!-- Filter bar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="16,12,16,4">
      <!-- Searchable creator combobox (type-to-filter). (1.46) -->
      <AutoCompleteBox Grid.Column="0" Width="180" Watermark="All creators"
                       ItemsSource="{Binding Library.Creators}"
                       Text="{Binding Library.CreatorFilter}"
                       FilterMode="Contains" />
      <TextBox Grid.Column="1" Margin="8,0" Watermark="Search packages…" Text="{Binding Library.SearchText}" />
      <CheckBox Grid.Column="2" Margin="8,0" Content="Favorites" IsChecked="{Binding Library.FavoritesOnly}" />
      <Button Grid.Column="3" Content="Refresh" Command="{Binding Library.RefreshCommand}" />
    </Grid>

    <!-- Column headers (click to sort) -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,160,110,90,90,60" Margin="18,4,18,0">
      <Button Grid.Column="0" Content="Name"    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding Library.SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Name}" />
      <Button Grid.Column="1" Content="Creator" Command="{Binding Library.SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Creator}" />
      <Button Grid.Column="2" Content="Type" />
      <Button Grid.Column="3" Content="Size"    Command="{Binding Library.SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Size}" />
      <Button Grid.Column="4" Content="Class"   Command="{Binding Library.SortByCommand}" CommandParameter="{x:Static lib:LibrarySort.Class}" />
      <TextBlock Grid.Column="5" Text="Deps" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" />
    </Grid>

    <!-- Detail panel -->
    <Border DockPanel.Dock="Right" Width="280" Margin="0,8,16,12" Padding="12"
            BorderBrush="#22808080" BorderThickness="1" CornerRadius="6"
            IsVisible="{Binding Library.SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6" DataContext="{Binding Library.SelectedEntry}" x:DataType="lib:PackageListEntry">
        <TextBlock Text="{Binding VarName}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Creator, StringFormat='by {0}'}" Opacity="0.8" />
        <TextBlock Text="{Binding PrimaryType, StringFormat='Type: {0}'}" Opacity="0.8" />
        <TextBlock Text="{Binding StorageClass, StringFormat='Class: {0}'}" Opacity="0.8" />
        <TextBlock Text="{Binding OnlineInstanceCount, StringFormat='Online copies: {0}'}" Opacity="0.8" />
        <TextBlock Text="Single copy — protected" Opacity="0.8"
                   IsVisible="{Binding IsSingleCopy}" Foreground="#C46210" />
        <TextBlock Text="Missing dependencies" Foreground="#B00020"
                   IsVisible="{Binding HasMissingDeps}" />
      </StackPanel>
    </Border>

    <!-- Status line -->
    <TextBlock DockPanel.Dock="Bottom" Margin="18,4,18,12" Opacity="0.7"
               Text="{Binding Library.TotalCount, StringFormat='{}{0} packages'}" />

    <!-- Content area with state overlays -->
    <Panel Margin="16,4">
      <!-- Table view: virtualized columned grid. (1.43) -->
      <ListBox ItemsSource="{Binding Library.Items}" SelectionMode="Multiple"
               SelectedItem="{Binding Library.SelectedEntry}"
               IsVisible="{Binding Library.IsTableView}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="lib:PackageListEntry">
            <Grid ColumnDefinitions="*,160,110,90,90,60" Height="26">
              <TextBlock Grid.Column="0" Text="{Binding VarName}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Creator}" VerticalAlignment="Center" Opacity="0.85" />
              <TextBlock Grid.Column="2" Text="{Binding PrimaryType}" VerticalAlignment="Center" Opacity="0.85" />
              <TextBlock Grid.Column="3" Text="{Binding TotalSize}" VerticalAlignment="Center" Opacity="0.85" />
              <TextBlock Grid.Column="4" Text="{Binding StorageClass}" VerticalAlignment="Center" Opacity="0.85" />
              <!-- Deps state encoded by text, not colour alone (colourblind-safe). -->
              <TextBlock Grid.Column="5" Text="!" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#B00020" IsVisible="{Binding HasMissingDeps}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Gallery view: virtualized thumbnail wall. (1.45) -->
      <ListBox ItemsSource="{Binding Library.Items}" SelectionMode="Multiple"
               SelectedItem="{Binding Library.SelectedEntry}"
               IsVisible="{Binding Library.IsGalleryView}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="lib:PackageListEntry">
            <Border Width="150" Height="130" Margin="4" Padding="8" BorderBrush="#22808080" BorderThickness="1" CornerRadius="6">
              <StackPanel Spacing="4">
                <Border Height="70" Background="#18808080" CornerRadius="4">
                  <TextBlock Text="{Binding PrimaryType}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                </Border>
                <TextBlock Text="{Binding PackageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Creator}" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding Library.IsLoading}" />
      <TextBlock Text="No packages match your filters." HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0.7" IsVisible="{Binding Library.IsEmpty}" />
      <TextBlock Text="Something went wrong loading the library." HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#B00020" IsVisible="{Binding Library.HasError}" />
    </Panel>

  </DockPanel>
</Window>
