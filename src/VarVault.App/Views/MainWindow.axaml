<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VarVault.App.ViewModels"
        xmlns:views="clr-namespace:VarVault.App.Views"
        xmlns:c="clr-namespace:VarVault.App.Controls"
        x:Class="VarVault.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="820" Title="VarVault"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Bg0Brush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding ShowCommandPaletteCommand}" />
  </Window.KeyBindings>

  <Window.DataTemplates>
    <!-- Map each screen view-model to its view (POL-4 shell hosting). -->
    <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="vm:LibraryViewModel"><views:LibraryView /></DataTemplate>
    <DataTemplate DataType="vm:PresetsViewModel"><views:PresetsView /></DataTemplate>
    <DataTemplate DataType="vm:TieringViewModel"><views:TieringView /></DataTemplate>
    <DataTemplate DataType="vm:DupesViewModel"><views:DupesView /></DataTemplate>
    <DataTemplate DataType="vm:ImportViewModel"><views:ImportView /></DataTemplate>
    <DataTemplate DataType="vm:AnalyticsViewModel"><views:AnalyticsView /></DataTemplate>
    <DataTemplate DataType="vm:ProposalsViewModel"><views:ProposalsView /></DataTemplate>
    <DataTemplate DataType="vm:HealthViewModel"><views:HealthView /></DataTemplate>
    <DataTemplate DataType="vm:MissingDepsViewModel"><views:MissingView /></DataTemplate>
    <DataTemplate DataType="vm:RepositoriesViewModel"><views:RepositoriesView /></DataTemplate>
    <DataTemplate DataType="vm:TrashViewModel"><views:TrashView /></DataTemplate>
    <DataTemplate DataType="vm:ActivityViewModel"><views:ActivityView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:PlaceholderScreenViewModel">
      <TextBlock Text="{Binding Title, StringFormat='{}{0} — coming soon'}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
    </DataTemplate>

    <!-- Dialog view-model → view map (GA-1 ModalHost hosting). -->
    <DataTemplate DataType="vm:OnboardingViewModel"><views:OnboardingDialog /></DataTemplate>
    <DataTemplate DataType="vm:AddRepoViewModel"><views:AddRepoDialog /></DataTemplate>
    <DataTemplate DataType="vm:EditRepoViewModel"><views:EditRepoDialog /></DataTemplate>
    <DataTemplate DataType="vm:MigrateViewModel"><views:MigrateDialog /></DataTemplate>
    <DataTemplate DataType="vm:FixEncodingViewModel"><views:FixDialog /></DataTemplate>
    <DataTemplate DataType="vm:DedupFixViewModel"><views:DedupFixDialog /></DataTemplate>
    <DataTemplate DataType="vm:AliasViewModel"><views:AliasDialog /></DataTemplate>
    <DataTemplate DataType="vm:ManageAliasesViewModel"><views:ManageAliasesDialog /></DataTemplate>
    <DataTemplate DataType="vm:ConfirmDeleteViewModel"><views:ConfirmDeleteDialog /></DataTemplate>
    <DataTemplate DataType="vm:PresetEditViewModel"><views:PresetEditDialog /></DataTemplate>
    <DataTemplate DataType="vm:DupeReviewViewModel"><views:DupeReviewDialog /></DataTemplate>
    <DataTemplate DataType="vm:RescueViewModel"><views:RescueDialog /></DataTemplate>
    <DataTemplate DataType="vm:VarDetailViewModel"><views:VarDetailDialog /></DataTemplate>
    <DataTemplate DataType="vm:EditMetaViewModel"><views:EditMetaDialog /></DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <Grid ColumnDefinitions="Auto,*">
      <views:RailView Grid.Column="0" DataContext="{Binding}" />
      <DockPanel Grid.Column="1" LastChildFill="True">
        <views:TopBarView DockPanel.Dock="Top" DataContext="{Binding}" />
        <views:LogDockView DockPanel.Dock="Bottom" DataContext="{Binding}" />
        <ContentControl Content="{Binding ActiveScreen}" />
      </DockPanel>
    </Grid>

    <!-- Jobs panel overlay (top-right) -->
    <views:JobsPanelView DataContext="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,14,0" />

    <!-- Modal dialog host (GA-1) — hosts whatever the dialog service currently shows -->
    <c:ModalHost x:Name="ModalHost" Content="{Binding Dialogs.Current}" IsOpen="{Binding Dialogs.IsOpen}" />

    <!-- Toast (bottom-center) -->
    <c:Toast Message="{Binding ToastMessage}" IsOpen="{Binding ToastVisible}" HasUndo="{Binding ToastHasUndo}"
             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" />

    <!-- Command palette overlay (Ctrl-K) — 24-checklist E9 -->
    <views:CommandPaletteView DataContext="{Binding CommandPalette}" IsVisible="{Binding IsOpen}" />
  </Panel>
</Window>
