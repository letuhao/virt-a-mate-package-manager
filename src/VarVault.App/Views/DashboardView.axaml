<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VarVault.App.Controls"
             xmlns:vm="clr-namespace:VarVault.App.ViewModels"
             xmlns:act="clr-namespace:VarVault.Sdk.Activation;assembly=VarVault.Sdk"
             x:Class="VarVault.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer Padding="18">
    <StackPanel Spacing="14">
      <!-- Screen head + actions (VM-scoped) -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="Dashboard" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextHiBrush}" />
          <TextBlock Name="PART_Header" Foreground="{DynamicResource TextLoBrush}"
                     Text="{Binding Summary.TotalPackages, StringFormat='{}{0} packages'}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Setup wizard" Margin="0,0,8,0" Command="{Binding SetupWizardCommand}" />
        <Button Grid.Column="2" Content="⛑ Rescue" Command="{Binding RescueCommand}" Foreground="{DynamicResource WarnBrush}" />
      </Grid>

      <WrapPanel>
        <c:Card Header="Storage by tier" Width="320" Margin="0,0,14,14">
          <ItemsControl ItemsSource="{Binding Summary.Tiers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3" x:CompileBindings="False">
                  <TextBlock Grid.Column="0" Text="{Binding Tier, StringFormat='T{0}'}" />
                  <c:MeterBar Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                              Value="{Binding UsedFraction}" Fill="{DynamicResource AccentBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding CapacityBytes, Converter={StaticResource BytesToSize}}" Opacity="0.7" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:Card>

        <c:Card Header="Classification" Width="320" Margin="0,0,14,14">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="46,*,Auto">
              <TextBlock Grid.Column="0" Text="Hot" Foreground="{DynamicResource HotBrush}" />
              <c:MeterBar Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Value="{Binding HotFraction}" Fill="{DynamicResource HotBrush}" Height="8" />
              <TextBlock Grid.Column="2" Text="{Binding Summary.HotCount}" Opacity="0.7" />
            </Grid>
            <Grid ColumnDefinitions="46,*,Auto">
              <TextBlock Grid.Column="0" Text="Warm" Foreground="{DynamicResource WarmBrush}" />
              <c:MeterBar Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Value="{Binding WarmFraction}" Fill="{DynamicResource WarmBrush}" Height="8" />
              <TextBlock Grid.Column="2" Text="{Binding Summary.WarmCount}" Opacity="0.7" />
            </Grid>
            <Grid ColumnDefinitions="46,*,Auto">
              <TextBlock Grid.Column="0" Text="Cold" Foreground="{DynamicResource ColdBrush}" />
              <c:MeterBar Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Value="{Binding ColdFraction}" Fill="{DynamicResource ColdBrush}" Height="8" />
              <TextBlock Grid.Column="2" Text="{Binding Summary.ColdCount}" Opacity="0.7" />
            </Grid>
          </StackPanel>
        </c:Card>

        <!-- Needs attention: clickable rows that navigate -->
        <c:Card Header="Needs your attention" Width="320" Margin="0,0,14,14">
          <StackPanel Spacing="6">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding GoCommand}" CommandParameter="missing"
                    Content="{Binding Summary.MissingDepsCount, StringFormat='{}{0} packages need dependencies →'}" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding GoCommand}" CommandParameter="proposals"
                    Content="Review proposals →" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding GoCommand}" CommandParameter="repos"
                    Content="{Binding Summary.OfflineRepositoryCount, StringFormat='{}{0} offline repositories →'}" />
          </StackPanel>
        </c:Card>

        <!-- Reclaimable space -->
        <c:Card Header="Reclaimable space" Width="320" Margin="0,0,14,14">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ReclaimableBytes, Converter={StaticResource BytesToSize}}" FontSize="24" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Redundant duplicate copies (exact, hash-verified)" Opacity="0.7" FontSize="12" />
            <Button Content="Open reclaim →" Command="{Binding GoCommand}" CommandParameter="dupes" HorizontalAlignment="Left" />
          </StackPanel>
        </c:Card>

        <!-- Recent activity -->
        <c:Card Header="Recent activity" Width="320" Margin="0,0,14,14">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding RecentActivity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="act:ActivityRecord">
                  <Grid ColumnDefinitions="Auto,*" Height="22">
                    <TextBlock Grid.Column="0" Text="{Binding Kind}" Opacity="0.85" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Description}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No recent activity." Opacity="0.6" FontSize="12" IsVisible="{Binding !HasRecentActivity}" />
            <Button Content="Full history →" Command="{Binding GoCommand}" CommandParameter="history" HorizontalAlignment="Left" />
          </StackPanel>
        </c:Card>

        <!-- Quick actions -->
        <c:Card Header="Quick actions" Width="320" Margin="0,0,14,14">
          <StackPanel Spacing="7">
            <Button Content="◨ Switch loading preset" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding GoCommand}" CommandParameter="presets" />
            <Button Content="+ Add repository" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding AddRepoCommand}" />
            <Button Content="▦ Browse library" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding GoCommand}" CommandParameter="library" />
          </StackPanel>
        </c:Card>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
