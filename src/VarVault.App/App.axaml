<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VarVault.App.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <!-- Accent token tuned per theme variant so it reads well on both grounds. (X.15) -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AccentColor">#2F5E8F</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AccentColor">#6AA0DC</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <Color x:Key="AccentColor">#3B6EA5</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
