<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Server GC (per-core heaps, concurrent) — the parallel indexer decompresses JSON on many threads; workstation
         GC serialized them and cost ~3x on inspection. Server GC unlocks the parallelism. (perf.) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Windows .exe icon (Explorer / taskbar pin), sourced from the repo-root app.ico. -->
    <ApplicationIcon>..\..\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same file embedded as an Avalonia asset for the runtime window icon (title bar + live taskbar). -->
    <AvaloniaResource Include="..\..\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VarVault.Common\VarVault.Common.csproj" />
    <ProjectReference Include="..\VarVault.Sdk\VarVault.Sdk.csproj" />
    <ProjectReference Include="..\VarVault.Host\VarVault.Host.csproj" />
    <!-- Build the worker exe alongside the GUI so IndexerProcessHost can spawn it. (A12.) -->
    <ProjectReference Include="..\VarVault.Indexer\VarVault.Indexer.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyIndexerWorker" AfterTargets="Build">
    <ItemGroup>
      <_IndexerFiles Include="..\VarVault.Indexer\bin\$(Configuration)\$(TargetFramework)\VarVault.Indexer*" />
      <_IndexerFiles Include="..\VarVault.Indexer\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_IndexerFiles Include="..\VarVault.Indexer\bin\$(Configuration)\$(TargetFramework)\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_IndexerFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
