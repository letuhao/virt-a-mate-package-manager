<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VarVault.Host\VarVault.Host.csproj" />
    <ProjectReference Include="..\VarVault.Sdk\VarVault.Sdk.csproj" />
    <ProjectReference Include="..\VarVault.Common\VarVault.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Server GC — matches the App: the parallel indexer needs concurrent per-core GC. (perf.) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
