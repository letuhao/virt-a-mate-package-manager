<Window x:Class="VirtaMatePackageManager.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtaMatePackageManager.Presentation"
        xmlns:converters="clr-namespace:VirtaMatePackageManager.Presentation.Converters"
        mc:Ignorable="d"
        Title="Virt-a-Mate Package Manager" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#F0F0F0">
            <MenuItem Header="_File">
                <MenuItem Header="_Exit" Click="MenuItemExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Repository">
                <MenuItem Header="_Manage Repositories..." Click="MenuItemManageRepositories_Click"/>
                <MenuItem Header="_Scan All Repositories" Click="MenuItemScanRepositories_Click"/>
            </MenuItem>
            <MenuItem Header="_Installation">
                <MenuItem Header="_Manage Installation Targets..." Click="MenuItemManageInstallationTargets_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Backend Settings..." Click="MenuItemBackendSettings_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About..." Click="MenuItemAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="#F5F5F5">
            <Button Content="Refresh" Command="{Binding RefreshVarPackagesCommand}" Margin="5,0"/>
            <Separator/>
            <Button Content="Install" Command="{Binding InstallVarPackageCommand}" Margin="5,0"/>
            <Button Content="Uninstall" Command="{Binding UninstallVarPackageCommand}" Margin="5,0"/>
            <Separator/>
            <Label Content="Search:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="200" Margin="5,0"/>
            <Button Content="Search" Command="{Binding SearchCommand}" Margin="5,0"/>
        </ToolBar>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Repositories Panel -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Repositories" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Repositories}"
                             DisplayMemberPath="Name"
                             SelectedItem="{Binding SelectedRepository}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- VAR Packages List -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="VAR Packages" FontWeight="Bold" Margin="0,0,0,5">
                        <Run Text="{Binding VarPackages.Count, Mode=OneWay}"/>
                        <Run Text="of"/>
                        <Run Text="{Binding TotalVarPackages, Mode=OneWay}"/>
                    </TextBlock>
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding VarPackages}"
                              SelectedItem="{Binding SelectedVarPackage}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VAR Name" Binding="{Binding VarName}" Width="*"/>
                            <DataGridTextColumn Header="Creator" Binding="{Binding CreatorName}" Width="150"/>
                            <DataGridTextColumn Header="Package" Binding="{Binding PackageName}" Width="150"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Width="120"/>
                            <DataGridTextColumn Header="License" Binding="{Binding LicenseType}" Width="100"/>
                            <DataGridTextColumn Header="Status" Width="150">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="InstallationStatus.InstallationTargetName">
                                        <Binding.FallbackValue>Not Installed</Binding.FallbackValue>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstallationStatus}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Foreground" Value="Green"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Install" Command="{Binding InstallVarPackageCommand}"/>
                                <MenuItem Header="Uninstall" Command="{Binding UninstallVarPackageCommand}"/>
                                <Separator/>
                                <MenuItem Header="Show Details" Command="{Binding ShowVarPackageDetailsCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#E0E0E0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Loading..." Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="5,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
