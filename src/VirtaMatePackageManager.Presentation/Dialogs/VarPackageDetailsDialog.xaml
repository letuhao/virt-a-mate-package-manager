<Window x:Class="VirtaMatePackageManager.Presentation.Dialogs.VarPackageDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtaMatePackageManager.Presentation.Dialogs"
        xmlns:converters="clr-namespace:VirtaMatePackageManager.Presentation.Converters"
        mc:Ignorable="d"
        Title="VAR Package Details" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Title and Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding VarPackage.VarName}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding VarPackage.Description}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Creator: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VarPackage.CreatorName}"/>
                    <TextBlock Text="  |  Package: " FontWeight="SemiBold" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding VarPackage.PackageName}"/>
                    <TextBlock Text="  |  Version: " FontWeight="SemiBold" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding VarPackage.Version}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
            <Button Content="Install" 
                    Command="{Binding InstallCommand}"
                    Padding="20,8"
                    Margin="0,0,0,5"
                    MinWidth="100">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Uninstall" 
                    Command="{Binding UninstallCommand}"
                    Padding="20,8"
                    Margin="0,0,0,5"
                    MinWidth="100">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
                <Button Content="Extract Preview" 
                        Command="{Binding ExtractPreviewCommand}"
                        Padding="20,8"
                        MinWidth="100"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Preview Image Thumbnail -->
                        <GroupBox Grid.Row="0" Header="Preview" Margin="0,0,0,10">
                            <Grid Margin="5">
                                <Image Source="{Binding VarPackage.PreviewImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                       MaxWidth="200"
                                       MaxHeight="150"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="No preview available" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontStyle="Italic"
                                           Foreground="Gray"
                                           Visibility="{Binding VarPackage.PreviewImagePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </GroupBox>
                        
                        <!-- Basic Information -->
                        <GroupBox Grid.Row="1" Header="Basic Information" Margin="0,0,0,10">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="File Path:" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Text="{Binding VarPackage.FilePath}" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,5"/>

                                <TextBlock Text="File Size:" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
                                    <TextBlock.Text>
                                        <Binding Path="VarPackage.FileSize" Converter="{StaticResource FileSizeConverter}"/>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Text="License:" Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Text="{Binding VarPackage.LicenseType, FallbackValue='Not specified'}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Repository:" Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Text="{Binding VarPackage.RepositoryName}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Created:" Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Text="{Binding VarPackage.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="File Hash:" Grid.Row="5" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Text="{Binding VarPackage.FileHash, FallbackValue='Not computed'}" Grid.Row="5" Grid.Column="1" FontFamily="Consolas" FontSize="10" Margin="0,0,0,5"/>
                            </Grid>
                        </GroupBox>

                        <!-- Installation Status -->
                        <GroupBox Grid.Row="2" Header="Installation Status" Margin="0,0,0,10">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding InstallationStatus.InstallationTargetName, FallbackValue='Not Installed'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="1" Text="Installed to: " FontWeight="SemiBold" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Row="1" Text="{Binding InstallationStatus.SymlinkPath}" TextWrapping="Wrap" Margin="80,0,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Credits -->
                        <GroupBox Grid.Row="3" Header="Credits" Margin="0,0,0,10" Visibility="{Binding VarPackage.Credits, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding VarPackage.Credits}" TextWrapping="Wrap" Margin="5"/>
                        </GroupBox>

                        <!-- Metadata -->
                        <GroupBox Grid.Row="4" Header="Additional Metadata" Margin="0,0,0,10" Visibility="{Binding Metadata, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                            <Grid Margin="5" Visibility="{Binding Metadata, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="{Binding Metadata.Instructions}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Visibility="{Binding Metadata.PromotionalLink, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                    <Hyperlink NavigateUri="{Binding Metadata.PromotionalLink}" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{Binding Metadata.PromotionalLink}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Dependencies">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Required Dependencies" Margin="5">
                        <DataGrid ItemsSource="{Binding Dependencies}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dependency Name" Binding="{Binding DependencyName}" Width="*"/>
                                <DataGridTextColumn Header="Version Constraint" Binding="{Binding VersionConstraint, FallbackValue='-'}" Width="150"/>
                                <DataGridCheckBoxColumn Header="Optional" Binding="{Binding IsOptional}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Resolved" Binding="{Binding IsResolved}" Width="80"/>
                                <DataGridTextColumn Header="Resolved VAR" Binding="{Binding ResolvedVarName, FallbackValue='-'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="LightGray"/>

                    <GroupBox Grid.Row="2" Header="Reverse Dependencies (VARs that depend on this)" Margin="5">
                        <DataGrid ItemsSource="{Binding ReverseDependencies}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VAR Name" Binding="{Binding VarName}" Width="*"/>
                                <DataGridTextColumn Header="Creator" Binding="{Binding CreatorName}" Width="150"/>
                                <DataGridTextColumn Header="Repository" Binding="{Binding RepositoryName}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Preview">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Preview Image Display -->
                    <ScrollViewer Grid.Row="0" 
                                  HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                Background="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="5">
                            <Image Source="{Binding VarPackage.PreviewImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                   MaxWidth="800"
                                   MaxHeight="600"
                                   Stretch="Uniform">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <Trigger Property="Source" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>
                    </ScrollViewer>
                    
                    <!-- No Preview Message -->
                    <Grid Grid.Row="0" 
                          Visibility="{Binding VarPackage.PreviewImagePath, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="No preview image available. Click 'Extract Preview' button to extract preview images from the VAR file."
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="20"/>
                    </Grid>
                    
                    <!-- Preview Info -->
                    <Border Grid.Row="1" 
                            Background="#F0F0F0" 
                            Padding="10"
                            Margin="0,5,0,0">
                        <StackPanel>
                            <TextBlock Text="Preview Image Path:" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding VarPackage.PreviewImagePath, FallbackValue='Not extracted'}" 
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"
                                       FontFamily="Consolas"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            
            <TabItem Header="Content" Visibility="{Binding Metadata, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <ItemsControl ItemsSource="{Binding Metadata.ContentList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#E0E0E0" Margin="0,5,0,0">
            <TextBlock Text="{Binding StatusMessage}"/>
        </StatusBar>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">
            <Button Content="Refresh" 
                    Command="{Binding RefreshCommand}"
                    Padding="15,5"
                    Margin="0,0,5,0"
                    MinWidth="80"/>
            <Button Content="Close" 
                    IsCancel="True"
                    Padding="15,5"
                    MinWidth="80"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

