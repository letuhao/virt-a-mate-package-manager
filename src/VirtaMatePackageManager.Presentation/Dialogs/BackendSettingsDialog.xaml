<Window x:Class="VirtaMatePackageManager.Presentation.Dialogs.BackendSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtaMatePackageManager.Presentation.Dialogs"
        xmlns:converters="clr-namespace:VirtaMatePackageManager.Presentation.Converters"
        mc:Ignorable="d"
        Title="Backend Settings" Height="400" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:StatusForegroundConverter x:Key="StatusForegroundConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Database Connection Settings" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <!-- Connection String Label -->
        <TextBlock Grid.Row="1" 
                   Text="Connection String:" 
                   Margin="0,0,0,5"/>

        <!-- Connection String Input -->
        <TextBox Grid.Row="2" 
                 Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Height="80"
                 Margin="0,0,0,10"
                 FontFamily="Consolas"
                 FontSize="11"/>

        <!-- Status Message -->
        <Border Grid.Row="3" 
                Background="#F5F5F5"
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10"
                Margin="0,0,0,10"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="{Binding IsConnectionSuccessful, Converter={StaticResource StatusForegroundConverter}}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Test Connection Button -->
        <Button Grid.Row="4" 
                Command="{Binding TestConnectionCommand}"
                HorizontalAlignment="Left"
                Width="150"
                Height="30"
                Margin="0,0,0,15">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content" Value="Test Connection"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTesting}" Value="True">
                            <Setter Property="Content" Value="Testing..."/>
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Help Text -->
        <Border Grid.Row="5" 
                Background="#F5F5F5" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                Padding="10"
                Margin="0,0,0,15">
            <TextBlock TextWrapping="Wrap" FontSize="11">
                <Run Text="Connection String Format:" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="Host=localhost;Port=5432;Database=virtamate_package_manager;Username=postgres;Password=postgres"/>
                <LineBreak/><LineBreak/>
                <Run Text="Note: After saving, you must restart the application for the changes to take effect." FontStyle="Italic"/>
            </TextBlock>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Save" 
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Width="100"
                    Height="30"/>
        </StackPanel>
    </Grid>
</Window>

