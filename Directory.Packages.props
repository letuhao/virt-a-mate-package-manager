<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- doc 26 · G-8 — allow pinning CVE-patched versions of transitive dependencies. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Composition / DI / hosting -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Diagnostics / monitoring -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.0.0" />
    <!-- Presentation (MVVM + Avalonia) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Avalonia" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.2.3" />
    <!-- Persistence -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <!-- Legacy CJK codepages (GBK/GB18030/Shift-JIS/Big5/EUC-KR) for encoding detection/fix -->
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- doc 26 · G-9 — runtime-visible skips (Skip.If) for corpus-gated real-data tests, on xUnit v2.
         (Literal xUnit v3 is coupled to an Avalonia 11.3 upgrade for the 50 AvaloniaFact tests; SkippableFact
         delivers the actual goal — masked environments show as SKIPPED, not green — without that risk.) -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- doc 26 · G-8 — CVE-patched transitive deps (clears NU1903; pinned via transitive pinning above).
         lib.e_sqlite3 2.1.12 is a native-SQLite patch compatible with SQLitePCLRaw.core 2.1.x. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <!-- doc 31 · Import archive extraction. SharpCompress (pure-managed, zip/7z/rar/tar) with a CustomDecoder wired to
         VarVault's own CJK detection so legacy-encoded entry names decode correctly; optional 7z-binary fallback via
         the `import.sevenzip_path` setting. (30-spec §6 amendment A1, 2026-07-20.) -->
    <PackageVersion Include="SharpCompress" Version="0.50.0" />
    <!-- Thumbnail downscaling on extraction (server-side resize/re-encode). Version matches Avalonia's Skia so
         there's no native/managed mismatch. -->
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
</Project>
